<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>2e14f8c6-4d60-481b-bfb6-798695efc8f4</groupId>
	<artifactId>platform-lifecycle-orchestrator</artifactId>
	<version>1.0.12</version>
	<packaging>mule-application</packaging>
	<name>platform-lifecycle-orchestrator</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<app.runtime>4.9.18</app.runtime>
		<mule.maven.plugin.version>4.10.0</mule.maven.plugin.version>
		<!-- MUnit 3.6.3+ is REQUIRED on Mule 4.9 / Java 17 (fixes W-20335051:
		     "java.naming not open to MUnit starter"). Drives runner, tools, and plugin. -->
		<munit.version>3.6.3</munit.version>

		<!-- ══════════════════════════════════════════════════════════════════
		     CloudHub 2.0 deploy knobs — property-driven so the shared CI deploy
		     workflow (mule-ci-cd/deploy-ch2.yml) can override every value with -D.
		     Defaults below keep a plain local `mvn clean deploy -DmuleDeploy` working.
		     ══════════════════════════════════════════════════════════════════ -->
		<ch2.appName>${project.artifactId}</ch2.appName>
		<ch2.muleVersion>${app.runtime}</ch2.muleVersion>
		<ch2.javaVersion>17</ch2.javaVersion>
		<ch2.environment>dev</ch2.environment>
		<ch2.target>Cloudhub-US-East-2</ch2.target>
		<ch2.replicas>1</ch2.replicas>
		<ch2.vCores>0.1</ch2.vCores>
		<!-- Runtime env selects config-${env}.yaml + config-secure-${env}.yaml at boot -->
		<ch2.runtimeEnv>dev</ch2.runtimeEnv>
	</properties>

	<build>
		<plugins>
			<!-- MUnit test runner — executes src/test/munit/*.xml suites -->
			<plugin>
				<groupId>com.mulesoft.munit.tools</groupId>
				<artifactId>munit-maven-plugin</artifactId>
				<version>${munit.version}</version>
				<executions>
					<execution>
						<id>test</id>
						<phase>test</phase>
						<goals>
							<goal>test</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!--
						Run against the exact target runtime.
					-->
					<runtimeVersion>${app.runtime}</runtimeVersion>
					<runtimeProduct>MULE_EE</runtimeProduct>
					<!--
						Java 17 / Mule 4.9 embedded container:
						Do NOT add add-opens / add-exports here — MUnit 3.6.3 opens the
						required JPMS modules itself, and the embedded container REJECTS any
						boot-module-layer tweaks ("Invalid module tweaking options...").
						Only -D system properties are passed: env selects
						config-secure-test.yaml; encrypt.key initialises the secure-properties
						module (32 chars for AES-256; test values are plaintext placeholders).
					-->
					<argLines>
						<argLine>-Denv=test</argLine>
						<argLine>-Dencrypt.key=test-encrypt-key-32-chars-1234!</argLine>
					</argLines>
					<coverage>
						<runCoverage>true</runCoverage>
						<formats>
							<format>console</format>
						</formats>
						<failBuild>false</failBuild>
					</coverage>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<version>${mule.maven.plugin.version}</version>
				<extensions>true</extensions>
				<configuration>
					<classifier>---- select project type ----</classifier>
					<cloudhub2Deployment>
						<uri>https://anypoint.mulesoft.com</uri>
						<provider>MC</provider>
						<environment>${ch2.environment}</environment>
						<target>${ch2.target}</target>
						<muleVersion>${ch2.muleVersion}</muleVersion>
						<javaVersion>${ch2.javaVersion}</javaVersion>
						<applicationName>${ch2.appName}</applicationName>
						<businessGroupId>2e14f8c6-4d60-481b-bfb6-798695efc8f4</businessGroupId>
						<replicas>${ch2.replicas}</replicas>
						<vCores>${ch2.vCores}</vCores>
						<!--
							Connected App auth for programmatic deploy. NO secret literals here:
							values resolve from .mvn/settings.xml (env-var backed) or -D overrides.
							The Connected App needs the "Design Center Developer" scope plus
							CloudHub 2.0 / Runtime Manager deploy permissions.
						-->
						<connectedAppClientId>${connectedApp.clientId}</connectedAppClientId>
						<connectedAppClientSecret>${connectedApp.clientSecret}</connectedAppClientSecret>
						<connectedAppGrantType>client_credentials</connectedAppGrantType>
						<deploymentSettings>
							<generateDefaultPublicUrl>true</generateDefaultPublicUrl>
						</deploymentSettings>
						<!-- Non-secret runtime properties -->
						<properties>
							<env>${ch2.runtimeEnv}</env>
							<!--
								API Autodiscovery ENVIRONMENT credentials. These are reserved property
								names the runtime's API Gateway reads at startup to register this app
								against its API Manager instance (api.id). MUST be pushed to the worker
								as runtime properties — passing them only as -D flags to the Maven JVM
								does NOT reach CloudHub. client_id is non-secret; the secret is masked
								via <secureProperties> below. Values resolve from .mvn/settings.xml
								(env-var backed) or -Danypoint.platform.client_id=... at deploy time.
							-->
							<anypoint.platform.client_id>${anypoint.platform.client_id}</anypoint.platform.client_id>
						</properties>
						<!--
							Secret runtime properties. CloudHub 2.0 encrypts these before storing,
							and mule-artifact.json lists them under secureProperties so the value is
							masked in Runtime Manager. encrypt.key is the AES-256 master key that
							decrypts config-secure-${env}.yaml; it is NEVER committed — supplied via
							.mvn/settings.xml (env.ENCRYPT_KEY) or -Dencrypt.key=... at deploy time.
						-->
						<secureProperties>
							<encrypt.key>${encrypt.key}</encrypt.key>
							<anypoint.platform.client_secret>${anypoint.platform.client_secret}</anypoint.platform.client_secret>
						</secureProperties>
					</cloudhub2Deployment>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>17</source>
					<target>17</target>
				</configuration>
			</plugin>

			<!-- Runs the plain-JUnit contract drift guard (src/test/java) in the test phase,
			     alongside MUnit (which runs via munit-maven-plugin). The mule-application
			     lifecycle already binds Surefire's default-test execution; declaring the plugin
			     here just pins the version (3.2.5, needed for JUnit 5 auto-detection on Java 17). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!--
					Suppress m2e "Plugin execution not covered by lifecycle configuration" markers.
					This section is IDE-only and has no effect on the Maven build.
				-->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.mule.tools.maven</groupId>
										<artifactId>mule-maven-plugin</artifactId>
										<versionRange>[1.0,)</versionRange>
										<goals>
											<goal>validate</goal>
											<goal>initialize</goal>
											<goal>generate-sources</goal>
											<goal>process-sources</goal>
											<goal>process-resources</goal>
											<goal>compile</goal>
											<goal>process-classes</goal>
											<goal>generate-test-sources</goal>
											<goal>process-test-sources</goal>
											<goal>generate-test-resources</goal>
											<goal>process-test-resources</goal>
											<goal>test-compile</goal>
											<goal>process-test-classes</goal>
											<goal>test</goal>
											<goal>prepare-package</goal>
											<goal>package</goal>
											<goal>pre-integration-test</goal>
											<goal>integration-test</goal>
											<goal>post-integration-test</goal>
											<goal>verify</goal>
											<goal>install</goal>
											<goal>deploy</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore/>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<dependencies>
		<!-- HTTP Connector (standard — org.mule.connectors) -->
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-http-connector</artifactId>
			<version>1.11.3</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- APIkit Module (standard — org.mule.modules) -->
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-apikit-module</artifactId>
			<version>1.11.18</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- Secure Configuration Properties Module (Exchange — needs auth) -->
		<dependency>
			<groupId>com.mulesoft.modules</groupId>
			<artifactId>mule-secure-configuration-property-module</artifactId>
			<version>1.2.7</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- Object Store v2 Connector (standard — org.mule.connectors) -->
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-objectstore-connector</artifactId>
			<version>1.3.0</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- MCP Connector — exposes Mule flows as MCP tools (Exchange — needs auth) -->
		<dependency>
			<groupId>com.mulesoft.connectors</groupId>
			<artifactId>mule-mcp-connector</artifactId>
			<version>1.5.0</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- Tracing Module — MDC logging variables (jobId/appName/externalTranId).
		     groupId is org.mule.modules (the docs' com.mulesoft.modules is a doc error).
		     1.2.1 (May 2026) fixes Java 17 connector metadata generation (W-21748187);
		     compatible with Mule 4.4+ on OpenJDK 8/11/17. -->
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-tracing-module</artifactId>
			<version>1.2.1</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- MUnit Test Dependencies (Exchange — needs auth) -->
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-runner</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-tools</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>

		<!-- Plain-JUnit contract drift guard (src/test/java) — asserts the MCP tools'
		     advertised parameters-schema stays structurally in sync with the canonical
		     schema/*.json single-source-of-truth files. Test-scope only; never packaged. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.10.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.17.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>2e14f8c6-4d60-481b-bfb6-798695efc8f4</groupId>
			<artifactId>platform-lifecycle-orchestrator-api</artifactId>
			<version>1.0.6</version>
			<classifier>raml</classifier>
			<type>zip</type>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange V3</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
			<layout>default</layout>
		</repository>
		<repository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/releases/</url>
			<layout>default</layout>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<layout>default</layout>
			<url>https://repository.mulesoft.org/releases/</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

</project>
