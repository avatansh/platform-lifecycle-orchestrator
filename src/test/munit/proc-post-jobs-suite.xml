<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/http         http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os           http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <!--
        proc-post-jobs-suite.xml
        Coverage for the transport-agnostic sub-flows in process/post-jobs.xml:
        pf-set-status, pf-release-lock (present + absent), pf-apply-transforms.
        (pf-start-upgrade + mf-impl-post-jobs are covered in proc-start-upgrade-suite.)
    -->
    <munit:config name="proc-post-jobs-suite" doc:id="ppj-suite-0001" />

    <!-- pf-set-status — merges status + updatedAt into the job record -->
    <munit:test name="postjobs-set-status" doc:id="ppj-test-0001"
                description="pf-set-status merges targetStatus into the persisted job record">
        <munit:behavior>
            <!-- os:store is left un-mocked so it passes the merged record through as the payload -->
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ jobId: 'job-ss-1', status: 'PROCESSING' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="jobId" value="job-ss-1" doc:name="PV jobId" />
            <set-variable variableName="targetStatus" value="COMMITTING" doc:name="PV targetStatus" />
            <flow-ref name="pf-set-status" doc:name="invoke pf-set-status" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="status merged" expression="#[payload.status]" is="#[MunitTools::equalTo('COMMITTING')]" />
        </munit:validation>
    </munit:test>

    <!-- pf-release-lock — lock present → removed -->
    <munit:test name="postjobs-release-lock-present" doc:id="ppj-test-0002"
                description="pf-release-lock removes the lock when present">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock OS contains=true" processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[true]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="lockPresent" value="#[true]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS remove" processor="os:remove">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[null]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[{ carried: 'payload' }]" doc:name="seed payload" />
            <set-variable variableName="lockApp" value="lock-app" doc:name="PV lockApp" />
            <flow-ref name="pf-release-lock" doc:name="invoke pf-release-lock" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="payload preserved" expression="#[payload.carried]" is="#[MunitTools::equalTo('payload')]" />
        </munit:validation>
    </munit:test>

    <!-- pf-release-lock — lock absent → no-op -->
    <munit:test name="postjobs-release-lock-absent" doc:id="ppj-test-0003"
                description="pf-release-lock is a no-op when the lock is absent">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock OS contains=false" processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[false]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="lockPresent" value="#[false]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="lockApp" value="lock-app-absent" doc:name="PV lockApp" />
            <flow-ref name="pf-release-lock" doc:name="invoke pf-release-lock (absent)" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="completed" expression="#[vars.lockApp]" is="#[MunitTools::equalTo('lock-app-absent')]" />
        </munit:validation>
    </munit:test>

    <!-- pf-apply-transforms — fetches each file and stages rewritten content -->
    <munit:test name="postjobs-apply-transforms" doc:id="ppj-test-0004"
                description="pf-apply-transforms fetches files and produces vars.stagedFiles">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock GET file contents" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ content: 'aGVsbG8=', encoding: 'base64' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="coords" value="#[{ owner: 'o', repo: 'r', defaultBranch: 'main' }]" doc:name="PV coords" />
            <set-variable variableName="changePlan"
                          value="#[{ headSha: 'HEAD1', fileEdits: [ { file: 'pom.xml', kind: 'noop' } ] }]"
                          doc:name="PV changePlan" />
            <flow-ref name="pf-apply-transforms" doc:name="invoke pf-apply-transforms" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="one staged file" expression="#[sizeOf(vars.stagedFiles default [])]" is="#[MunitTools::equalTo(1)]" />
            <munit-tools:assert-that doc:name="staged path" expression="#[vars.stagedFiles[0].path]" is="#[MunitTools::equalTo('pom.xml')]" />
        </munit:validation>
    </munit:test>

</mule>
