<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/os           http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/http         http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <!--
        sys-anypoint-suite.xml
        Coverage for system/anypoint.xml: pf-get-anypoint-token, pf-verify-deployment.
        All Anypoint HTTP calls are mocked. A single generic http:request mock satisfies the
        token POST, environments GET and AMC deployments GET within a flow invocation.
    -->
    <munit:config name="sys-anypoint-suite" doc:id="sap-suite-0001" />

    <!-- pf-get-anypoint-token — fetches + caches bearer token -->
    <munit:test name="anypoint-get-token" doc:id="sap-test-0001"
                description="pf-get-anypoint-token extracts access_token into vars.anypointToken">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock token POST" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ access_token: 'tok-123', expires_in: 3600 }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <!-- Guarantee a cache MISS so the mocked token POST fires: other suites (with
                 verify enabled) may have populated the shared token cache first. -->
            <os:clear objectStore="anypointTokenCacheOS" doc:name="clear token cache" />
            <flow-ref name="pf-get-anypoint-token" doc:name="invoke pf-get-anypoint-token" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="token set" expression="#[vars.anypointToken]" is="#[MunitTools::equalTo('tok-123')]" />
        </munit:validation>
    </munit:test>

    <!-- pf-verify-deployment — healthy deployment found -->
    <munit:test name="anypoint-verify-deployment-healthy" doc:id="sap-test-0002"
                description="pf-verify-deployment resolves env + deployment and reports healthy">
        <munit:behavior>
            <!-- Single mock serves the token POST, env GET (payload) and AMC deployments GET
                 (target=deployments). MUnit mocks do not route to the target attribute, so we
                 also set vars.deployments explicitly via the variables block. -->
            <munit-tools:mock-when doc:name="mock Anypoint HTTP" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{
                                             access_token: 'tok-123',
                                             data:  [ { name: 'Production', id: 'env-1' } ]
                                         }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="deployments"
                                              value="#[{ items: [ { name: 'verify-app', application: { status: 'RUNNING' } } ] }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="vfyApp" value="verify-app" doc:name="PV vfyApp" />
            <set-variable variableName="vfyEnv" value="Production" doc:name="PV vfyEnv" />
            <set-variable variableName="vfyOrgId" value="org-happy" doc:name="PV vfyOrgId" />
            <flow-ref name="pf-verify-deployment" doc:name="invoke pf-verify-deployment" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="verified" expression="#[vars.verify.verified]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that doc:name="healthy" expression="#[vars.verify.healthy]" is="#[MunitTools::equalTo(true)]" />
        </munit:validation>
    </munit:test>

    <!-- pf-verify-deployment — platform error → unverified fallback -->
    <munit:test name="anypoint-verify-deployment-error" doc:id="sap-test-0003"
                description="pf-verify-deployment falls back to unverified on any platform error">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock Anypoint HTTP error" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:error typeId="HTTP:CONNECTIVITY" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="vfyApp" value="verify-app-err" doc:name="PV vfyApp" />
            <set-variable variableName="vfyEnv" value="Production" doc:name="PV vfyEnv" />
            <set-variable variableName="vfyOrgId" value="org-err" doc:name="PV vfyOrgId" />
            <flow-ref name="pf-verify-deployment" doc:name="invoke pf-verify-deployment" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="unverified" expression="#[vars.verify.verified]" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that doc:name="status UNKNOWN" expression="#[vars.verify.status]" is="#[MunitTools::equalTo('UNKNOWN')]" />
        </munit:validation>
    </munit:test>

    <!-- ======================================================================
         Batch A #1 — pf-read-deployment (assessment ARM cross-check normaliser)
         ====================================================================== -->

    <!-- pf-read-deployment — deployment found → runtimeVersion surfaced -->
    <munit:test name="anypoint-read-deployment-found" doc:id="sap-test-0004"
                description="pf-read-deployment normalises a found deployment into vars.deployedState with runtimeVersion">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock Anypoint HTTP" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{
                                             access_token: 'tok-123',
                                             data:  [ { name: 'Development', id: 'env-1' } ]
                                         }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="deployments"
                                              value="#[{ items: [ { name: 'rd-app', application: { status: 'RUNNING' }, target: { deploymentSettings: { runtimeVersion: '4.6.0' } } } ] }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="vfyApp" value="rd-app" doc:name="PV vfyApp" />
            <set-variable variableName="vfyEnv" value="Development" doc:name="PV vfyEnv" />
            <set-variable variableName="vfyOrgId" value="org-rd-1" doc:name="PV vfyOrgId" />
            <flow-ref name="pf-read-deployment" doc:name="invoke pf-read-deployment" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="found" expression="#[vars.deployedState.found]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that doc:name="reachable" expression="#[vars.deployedState.reachable]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that doc:name="runtimeVersion" expression="#[vars.deployedState.runtimeVersion]" is="#[MunitTools::equalTo('4.6.0')]" />
        </munit:validation>
    </munit:test>

    <!-- pf-read-deployment — platform answered but no matching deployment -->
    <munit:test name="anypoint-read-deployment-not-found" doc:id="sap-test-0005"
                description="pf-read-deployment reports reachable but not found when no deployment matches">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock Anypoint HTTP" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{
                                             access_token: 'tok-123',
                                             data:  [ { name: 'Development', id: 'env-1' } ]
                                         }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="deployments" value="#[{ items: [] }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="vfyApp" value="no-such-app" doc:name="PV vfyApp" />
            <set-variable variableName="vfyEnv" value="Development" doc:name="PV vfyEnv" />
            <set-variable variableName="vfyOrgId" value="org-rd-2" doc:name="PV vfyOrgId" />
            <flow-ref name="pf-read-deployment" doc:name="invoke pf-read-deployment" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="not found" expression="#[vars.deployedState.found]" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that doc:name="reachable" expression="#[vars.deployedState.reachable]" is="#[MunitTools::equalTo(true)]" />
        </munit:validation>
    </munit:test>

    <!-- ======================================================================
         Batch A #6 — pf-read-api-policies (real API-policy detection)
         ====================================================================== -->

    <!-- pf-read-api-policies — matching API instance WITH an enabled policy → true -->
    <munit:test name="anypoint-read-api-policies-present" doc:id="sap-test-0006"
                description="pf-read-api-policies sets hasApiPolicies=true when a matched API instance has an enabled policy">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock Anypoint HTTP" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{
                                             access_token: 'tok-123',
                                             data:  [ { name: 'Development', id: 'env-1' } ]
                                         }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="apisResp"
                                              value="#[{ assets: [ { assetId: 'pol-app', apis: [ { id: 'api-55' } ] } ] }]" />
                        <munit-tools:variable key="policiesResp"
                                              value="#[{ policies: [ { policyId: 1, disabled: false } ] }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="hasApiPolicies" value="#[false]" doc:name="PV hasApiPolicies seed" />
            <set-variable variableName="apOrgId" value="org-ap-1" doc:name="PV apOrgId" />
            <set-variable variableName="apEnv" value="Development" doc:name="PV apEnv" />
            <set-variable variableName="apApp" value="pol-app" doc:name="PV apApp" />
            <flow-ref name="pf-read-api-policies" doc:name="invoke pf-read-api-policies" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="hasApiPolicies true" expression="#[vars.hasApiPolicies]" is="#[MunitTools::equalTo(true)]" />
        </munit:validation>
    </munit:test>

    <!-- pf-read-api-policies — no matching API instance → false (no managed API) -->
    <munit:test name="anypoint-read-api-policies-none" doc:id="sap-test-0007"
                description="pf-read-api-policies sets hasApiPolicies=false when no API instance matches the app">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock Anypoint HTTP" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{
                                             access_token: 'tok-123',
                                             data:  [ { name: 'Development', id: 'env-1' } ]
                                         }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="apisResp"
                                              value="#[{ assets: [ { assetId: 'other-app', apis: [ { id: 'api-1' } ] } ] }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="hasApiPolicies" value="#[true]" doc:name="PV hasApiPolicies seed" />
            <set-variable variableName="apOrgId" value="org-ap-2" doc:name="PV apOrgId" />
            <set-variable variableName="apEnv" value="Development" doc:name="PV apEnv" />
            <set-variable variableName="apApp" value="pol-app" doc:name="PV apApp" />
            <flow-ref name="pf-read-api-policies" doc:name="invoke pf-read-api-policies" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="hasApiPolicies false" expression="#[vars.hasApiPolicies]" is="#[MunitTools::equalTo(false)]" />
        </munit:validation>
    </munit:test>

    <!-- pf-read-api-policies — platform error → hasApiPolicies left UNCHANGED (non-fatal) -->
    <munit:test name="anypoint-read-api-policies-error" doc:id="sap-test-0008"
                description="pf-read-api-policies swallows platform errors and leaves hasApiPolicies unchanged">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock Anypoint HTTP error" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:error typeId="HTTP:CONNECTIVITY" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <os:clear objectStore="anypointTokenCacheOS" doc:name="clear token cache" />
            <set-variable variableName="hasApiPolicies" value="#[true]" doc:name="PV hasApiPolicies seed" />
            <set-variable variableName="apOrgId" value="org-ap-3" doc:name="PV apOrgId" />
            <set-variable variableName="apEnv" value="Development" doc:name="PV apEnv" />
            <set-variable variableName="apApp" value="err-app" doc:name="PV apApp" />
            <flow-ref name="pf-read-api-policies" doc:name="invoke pf-read-api-policies" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="hasApiPolicies unchanged" expression="#[vars.hasApiPolicies]" is="#[MunitTools::equalTo(true)]" />
        </munit:validation>
    </munit:test>

</mule>
