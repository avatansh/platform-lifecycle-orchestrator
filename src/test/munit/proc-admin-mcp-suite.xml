<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/os           http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <!--
        proc-admin-mcp-suite.xml
        Coverage for the admin delete-job flow (process/delete-job.xml), its REST + MCP wrappers,
        and the get_job_status MCP + REST wrappers. All Object Store access is mocked.
    -->
    <munit:config name="proc-admin-mcp-suite" doc:id="pam-suite-0001" />

    <!-- pf-delete-job happy path: job present with branch + held lock. -->
    <munit:test name="delete-pf-delete-job-happy" doc:id="pam-test-0001"
                description="pf-delete-job removes the job, clears the branch index and releases the lock">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ jobId: 'job-del-1', branchName: 'migrate/del-1', appName: 'del-app' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS remove" processor="os:remove">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[null]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS contains (lock held)" processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[true]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="lockExists" value="#[true]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="jobId" value="job-del-1" doc:name="PV jobId" />
            <flow-ref name="pf-delete-job" doc:name="invoke pf-delete-job" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="deleted true" expression="#[payload.deleted]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that doc:name="branch index cleared" expression="#[payload.branchIndexCleared]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that doc:name="lock released" expression="#[payload.lockReleased]" is="#[MunitTools::equalTo(true)]" />
        </munit:validation>
    </munit:test>

    <!-- REST wrapper: mf-impl-delete-job binds the URI jobId then delegates to pf-delete-job. -->
    <munit:test name="delete-rest-wrapper" doc:id="pam-test-0002"
                description="mf-impl-delete-job binds attributes.uriParams.jobId and deletes the job">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ jobId: 'job-del-2', appName: 'del-app-2' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS remove" processor="os:remove">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[null]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS contains (no lock)" processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[false]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="lockExists" value="#[false]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="event with uriParams.jobId">
                <munit:payload value="#[null]" />
                <munit:attributes value="#[{ uriParams: { jobId: 'job-del-2' } }]" mediaType="application/java" />
            </munit:set-event>
            <flow-ref name="mf-impl-delete-job" doc:name="invoke mf-impl-delete-job" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="deleted true" expression="#[payload.deleted]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that doc:name="no branch index" expression="#[payload.branchIndexCleared]" is="#[MunitTools::equalTo(false)]" />
        </munit:validation>
    </munit:test>

    <!-- MCP wrapper: delete_job-mcp-tool maps params then delegates to pf-delete-job. -->
    <munit:test name="delete-mcp-tool" doc:id="pam-test-0003"
                description="delete_job-mcp-tool maps the jobId param and deletes the job">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ jobId: 'job-del-3', appName: 'del-app-3' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS remove" processor="os:remove">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[null]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS contains (no lock)" processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[false]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="lockExists" value="#[false]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[{ jobId: 'job-del-3' }]" doc:name="PV payload (tool params)" />
            <flow-ref name="delete_job-mcp-tool" doc:name="invoke delete_job-mcp-tool" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="deleted true" expression="#[payload.deleted]" is="#[MunitTools::equalTo(true)]" />
        </munit:validation>
    </munit:test>

    <!-- MCP wrapper: get_job_status-mcp-tool maps jobId then delegates to pf-get-job-status. -->
    <munit:test name="status-mcp-tool" doc:id="pam-test-0004"
                description="get_job_status-mcp-tool maps the jobId param and returns the job status">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ jobId: 'job-st-1', status: 'PROCESSING', appName: 'st-app' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-payload value="#[{ jobId: 'job-st-1' }]" doc:name="PV payload (tool params)" />
            <flow-ref name="get_job_status-mcp-tool" doc:name="invoke get_job_status-mcp-tool" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="status returned" expression="#[payload.status]" is="#[MunitTools::equalTo('PROCESSING')]" />
        </munit:validation>
    </munit:test>

    <!-- REST wrapper: mf-impl-get-job-status binds the URI jobId then delegates to pf-get-job-status. -->
    <munit:test name="status-rest-wrapper" doc:id="pam-test-0005"
                description="mf-impl-get-job-status binds attributes.uriParams.jobId and returns the job status">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ jobId: 'job-st-2', status: 'DEPLOYED', appName: 'st-app-2', completedAt: '2025-01-01T00:00:00Z' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="event with uriParams.jobId">
                <munit:payload value="#[null]" />
                <munit:attributes value="#[{ uriParams: { jobId: 'job-st-2' } }]" mediaType="application/java" />
            </munit:set-event>
            <flow-ref name="mf-impl-get-job-status" doc:name="invoke mf-impl-get-job-status" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="status returned" expression="#[payload.status]" is="#[MunitTools::equalTo('DEPLOYED')]" />
        </munit:validation>
    </munit:test>

</mule>
