<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core          http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit         http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools   http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ee/core       http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/os            http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <!--
        pf-get-job-status-suite.xml
        Tests for the pf-get-job-status shared sub-flow.

        pf-get-job-status:
          · Reads vars.jobId
          · Calls os:retrieve (throws OS:KEY_NOT_FOUND when job absent → mapped to 404)
          · Builds a JobStatus response using statusMeta lookup table
          · Conditionally adds branchName, prUrl, prNumber, completedAt, error fields

        Test matrix:
          1. PROCESSING status  → message + nextPollSeconds=5, no optional fields
          2. PR_OPEN status     → message + nextPollSeconds=0 + prUrl + prNumber
          3. DEPLOYED status    → message + nextPollSeconds=0 + completedAt
          4. FAILED_COMMIT      → message + nextPollSeconds=0 + error field
          5. Unknown status     → fallback message + nextPollSeconds=10 (no error in record)

        All tests mock os:retrieve so the Object Store is never actually accessed.
    -->
    <munit:config name="pf-get-job-status-suite" doc:id="jss-suite-0001" />

    <!-- ──────────────────────────────────────────────────────────────────────────
         Test 1: PROCESSING — minimal fields; polling interval = 5 s
         ────────────────────────────────────────────────────────────────────────── -->
    <munit:test name="pf-get-job-status-PROCESSING"
                doc:id="jss-test-0001"
                description="PROCESSING status returns correct message, nextPollSeconds=5, and no optional fields">

        <munit:behavior>
            <!-- Mock the single os:retrieve in pf-get-job-status to return a PROCESSING record -->
            <munit-tools:mock-when doc:name="Mock OS retrieve — PROCESSING job"
                                   processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{ jobId: 'job-proc-001', status: 'PROCESSING', appName: 'test-app' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <set-variable variableName="jobId"
                          value="job-proc-001"
                          doc:name="PV SET jobId" />
            <flow-ref name="pf-get-job-status" doc:name="invoke pf-get-job-status" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert jobId echoed"
                expression="#[payload.jobId]"
                is="#[MunitTools::equalTo('job-proc-001')]" />
            <munit-tools:assert-that
                doc:name="assert status = PROCESSING"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('PROCESSING')]" />
            <munit-tools:assert-that
                doc:name="assert nextPollSeconds = 5"
                expression="#[payload.nextPollSeconds]"
                is="#[MunitTools::equalTo(5)]" />
            <munit-tools:assert-that
                doc:name="assert message is non-empty"
                expression="#[payload.message]"
                is="#[MunitTools::notNullValue()]" />
            <!-- Optional fields must NOT be present for a minimal record -->
            <munit-tools:assert-that
                doc:name="assert prUrl absent"
                expression="#[payload.prUrl?]"
                is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that
                doc:name="assert error absent"
                expression="#[payload.error?]"
                is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that
                doc:name="assert completedAt absent"
                expression="#[payload.completedAt?]"
                is="#[MunitTools::equalTo(false)]" />
            <!-- No Jira ticket on this record → jiraTicketId/jiraUrl must be absent -->
            <munit-tools:assert-that
                doc:name="assert jiraTicketId absent"
                expression="#[payload.jiraTicketId?]"
                is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that
                doc:name="assert jiraUrl absent"
                expression="#[payload.jiraUrl?]"
                is="#[MunitTools::equalTo(false)]" />
        </munit:validation>

    </munit:test>

    <!-- ──────────────────────────────────────────────────────────────────────────
         Test 2: PR_OPEN — nextPollSeconds=0, prUrl and prNumber included
         ────────────────────────────────────────────────────────────────────────── -->
    <munit:test name="pf-get-job-status-PR_OPEN"
                doc:id="jss-test-0002"
                description="PR_OPEN status returns nextPollSeconds=0 and includes prUrl and prNumber">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock OS retrieve — PR_OPEN job"
                                   processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{
                        jobId:    'job-pr-002',
                        status:   'PR_OPEN',
                        appName:  'test-app',
                        prNumber: 42,
                        prUrl:    'https://github.com/owner/repo/pull/42',
                        branchName: 'migrate/test-app-4.9.18-java17'
                    }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <set-variable variableName="jobId" value="job-pr-002" doc:name="PV SET jobId" />
            <flow-ref name="pf-get-job-status" doc:name="invoke pf-get-job-status" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert status = PR_OPEN"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('PR_OPEN')]" />
            <munit-tools:assert-that
                doc:name="assert nextPollSeconds = 0 (terminal for polling)"
                expression="#[payload.nextPollSeconds]"
                is="#[MunitTools::equalTo(0)]" />
            <munit-tools:assert-that
                doc:name="assert prUrl included"
                expression="#[payload.prUrl]"
                is="#[MunitTools::equalTo('https://github.com/owner/repo/pull/42')]" />
            <munit-tools:assert-that
                doc:name="assert prNumber included"
                expression="#[payload.prNumber]"
                is="#[MunitTools::equalTo(42)]" />
            <munit-tools:assert-that
                doc:name="assert branchName included"
                expression="#[payload.branchName]"
                is="#[MunitTools::equalTo('migrate/test-app-4.9.18-java17')]" />
            <!-- DEPLOYED-only fields must be absent -->
            <munit-tools:assert-that
                doc:name="assert completedAt absent"
                expression="#[payload.completedAt?]"
                is="#[MunitTools::equalTo(false)]" />
        </munit:validation>

    </munit:test>

    <!-- ──────────────────────────────────────────────────────────────────────────
         Test 3: DEPLOYED — nextPollSeconds=0, completedAt included
         ────────────────────────────────────────────────────────────────────────── -->
    <munit:test name="pf-get-job-status-DEPLOYED"
                doc:id="jss-test-0003"
                description="DEPLOYED status returns nextPollSeconds=0 and includes completedAt">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock OS retrieve — DEPLOYED job"
                                   processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{
                        jobId:       'job-dep-003',
                        status:      'DEPLOYED',
                        appName:     'test-app',
                        completedAt: '2025-06-01T12:00:00Z',
                        branchName:  'migrate/test-app-4.9.18-java17',
                        prUrl:       'https://github.com/owner/repo/pull/10',
                        prNumber:    10
                    }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <set-variable variableName="jobId" value="job-dep-003" doc:name="PV SET jobId" />
            <flow-ref name="pf-get-job-status" doc:name="invoke pf-get-job-status" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert status = DEPLOYED"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('DEPLOYED')]" />
            <munit-tools:assert-that
                doc:name="assert nextPollSeconds = 0"
                expression="#[payload.nextPollSeconds]"
                is="#[MunitTools::equalTo(0)]" />
            <munit-tools:assert-that
                doc:name="assert completedAt included"
                expression="#[payload.completedAt]"
                is="#[MunitTools::equalTo('2025-06-01T12:00:00Z')]" />
            <!-- DEPLOYED success → no error -->
            <munit-tools:assert-that
                doc:name="assert error absent"
                expression="#[payload.error?]"
                is="#[MunitTools::equalTo(false)]" />
        </munit:validation>

    </munit:test>

    <!-- ──────────────────────────────────────────────────────────────────────────
         Test 4: FAILED_COMMIT — nextPollSeconds=0, error field included
         ────────────────────────────────────────────────────────────────────────── -->
    <munit:test name="pf-get-job-status-FAILED_COMMIT"
                doc:id="jss-test-0004"
                description="FAILED_COMMIT status returns nextPollSeconds=0 and includes the error field">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock OS retrieve — FAILED_COMMIT job"
                                   processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{
                        jobId:    'job-fail-004',
                        status:   'FAILED_COMMIT',
                        appName:  'test-app',
                        error:    'GitHub API returned 422: Reference already exists'
                    }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <set-variable variableName="jobId" value="job-fail-004" doc:name="PV SET jobId" />
            <flow-ref name="pf-get-job-status" doc:name="invoke pf-get-job-status" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert status = FAILED_COMMIT"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('FAILED_COMMIT')]" />
            <munit-tools:assert-that
                doc:name="assert nextPollSeconds = 0"
                expression="#[payload.nextPollSeconds]"
                is="#[MunitTools::equalTo(0)]" />
            <munit-tools:assert-that
                doc:name="assert error field included"
                expression="#[payload.error]"
                is="#[MunitTools::containsString('422')]" />
        </munit:validation>

    </munit:test>

    <!-- ──────────────────────────────────────────────────────────────────────────
         Test 5: Unknown / unrecognised status — fallback message, nextPollSeconds=10
         ────────────────────────────────────────────────────────────────────────── -->
    <munit:test name="pf-get-job-status-unknown-status"
                doc:id="jss-test-0005"
                description="An unrecognised status value returns the fallback message and nextPollSeconds=10">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock OS retrieve — unknown status job"
                                   processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                                         value="#[{
                        jobId:   'job-unk-005',
                        status:  'CUSTOM_STATE',
                        appName: 'test-app'
                    }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <set-variable variableName="jobId" value="job-unk-005" doc:name="PV SET jobId" />
            <flow-ref name="pf-get-job-status" doc:name="invoke pf-get-job-status" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert status echoed verbatim"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('CUSTOM_STATE')]" />
            <!-- Fallback: nextPollSeconds = 10 -->
            <munit-tools:assert-that
                doc:name="assert fallback nextPollSeconds = 10"
                expression="#[payload.nextPollSeconds]"
                is="#[MunitTools::equalTo(10)]" />
            <!-- Fallback message must mention the status value -->
            <munit-tools:assert-that
                doc:name="assert fallback message non-empty"
                expression="#[payload.message]"
                is="#[MunitTools::notNullValue()]" />
        </munit:validation>

    </munit:test>

    <!-- ──────────────────────────────────────────────────────────────────────────
         Test 6: job with a Jira ticket → jiraTicketId + clickable jiraUrl included
         ────────────────────────────────────────────────────────────────────────── -->
    <munit:test name="pf-get-job-status-with-jira"
                doc:id="jss-test-0006"
                description="A job carrying a jiraTicketId returns jiraTicketId and a clickable jiraUrl (baseUrl + /browse/KEY)">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock OS retrieve — job with jira"
                                   processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[{
                        jobId:        'job-jira-006',
                        status:       'PR_OPEN',
                        appName:      'test-app',
                        jiraTicketId: 'J1U-123',
                        prUrl:        'https://github.com/owner/repo/pull/9',
                        prNumber:     9
                    }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <set-variable variableName="jobId" value="job-jira-006" doc:name="PV SET jobId" />
            <flow-ref name="pf-get-job-status" doc:name="invoke pf-get-job-status" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert jiraTicketId included"
                expression="#[payload.jiraTicketId]"
                is="#[MunitTools::equalTo('J1U-123')]" />
            <munit-tools:assert-that
                doc:name="assert jiraUrl points at the ticket"
                expression="#[payload.jiraUrl]"
                is="#[MunitTools::containsString('/browse/J1U-123')]" />
        </munit:validation>

    </munit:test>

    <!-- ──────────────────────────────────────────────────────────────────────────
         Test 7: PR_OPEN + munit.result=passed → message reflects the "MUnit passed"
         sub-stage while status stays PR_OPEN (RAML enum unchanged).
         ────────────────────────────────────────────────────────────────────────── -->
    <munit:test name="pf-get-job-status-PR_OPEN-munit-passed"
                doc:id="jss-test-0007"
                description="A PR_OPEN job with a munit-passed marker returns the enriched 'MUnit tests passed' message; status stays PR_OPEN">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock OS retrieve — PR_OPEN munit-passed job"
                                   processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[{
                        jobId:    'job-mp-007',
                        status:   'PR_OPEN',
                        appName:  'test-app',
                        prNumber: 12,
                        prUrl:    'https://github.com/owner/repo/pull/12',
                        munit:    { result: 'passed', at: '2025-06-01T12:00:00Z' }
                    }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <set-variable variableName="jobId" value="job-mp-007" doc:name="PV SET jobId" />
            <flow-ref name="pf-get-job-status" doc:name="invoke pf-get-job-status" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert status still PR_OPEN"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('PR_OPEN')]" />
            <munit-tools:assert-that
                doc:name="assert message reflects MUnit passed"
                expression="#[payload.message]"
                is="#[MunitTools::containsString('MUnit tests passed')]" />
        </munit:validation>

    </munit:test>

    <!-- ──────────────────────────────────────────────────────────────────────────
         Test 8: DEP_GUARD_FAILED → paused message + report array surfaced from
         depGuard.report so the caller/agent knows exactly what to pin.
         ────────────────────────────────────────────────────────────────────────── -->
    <munit:test name="pf-get-job-status-DEP_GUARD_FAILED"
                doc:id="jss-test-0008"
                description="A DEP_GUARD_FAILED job surfaces the dependency-guard violations report and a paused message">

        <munit:behavior>
            <munit-tools:mock-when doc:name="Mock OS retrieve — DEP_GUARD_FAILED job"
                                   processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[{
                        jobId:    'job-dg-008',
                        status:   'DEP_GUARD_FAILED',
                        appName:  'test-app',
                        prUrl:    'https://github.com/owner/repo/pull/8',
                        error:    '1 Java 17 dependency violation',
                        depGuard: { at: '2025-06-01T12:00:00Z', report: [
                            { groupId: 'org.mule.connectors', artifactId: 'mule-objectstore-connector', resolvedVersion: '1.2.0', requiredVersion: '1.2.2', reason: 'below Java 17 minimum' }
                        ] }
                    }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <set-variable variableName="jobId" value="job-dg-008" doc:name="PV SET jobId" />
            <flow-ref name="pf-get-job-status" doc:name="invoke pf-get-job-status" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert status = DEP_GUARD_FAILED"
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('DEP_GUARD_FAILED')]" />
            <munit-tools:assert-that
                doc:name="assert report surfaced (1 entry)"
                expression="#[sizeOf(payload.report default [])]"
                is="#[MunitTools::equalTo(1)]" />
            <munit-tools:assert-that
                doc:name="assert report names the offending artifact"
                expression="#[payload.report[0].artifactId]"
                is="#[MunitTools::equalTo('mule-objectstore-connector')]" />
            <munit-tools:assert-that
                doc:name="assert message mentions dependency guard"
                expression="#[payload.message]"
                is="#[MunitTools::containsString('dependency guard')]" />
        </munit:validation>

    </munit:test>

</mule>