<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/http         http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <!--
        global-error-handler-suite.xml
        Coverage for global/global-error-handler.xml (global-error-handler + mcp-error-handler).

        Both are named error-handlers referenced by app flows. To exercise every mapped
        on-error-continue branch deterministically, this suite defines two THIN helper flows
        (below) that contain a single mockable http:request and delegate error handling to the
        real named error-handler. Each test mocks that http:request to THROW a chosen error
        typeId (raise-error cannot target reserved extension namespaces such as APIKIT/OS,
        but a mock can simulate an extension throwing them). The helper flows live in the test
        config so they do not count toward coverage — only the app error-handler processors do.
    -->
    <munit:config name="global-error-handler-suite" doc:id="geh-suite-0001" />

    <!-- ═══════════════ helper flows (test-only) ═══════════════ -->
    <flow name="teh-global-raiser" doc:id="geh-helper-0001">
        <http:request config-ref="GitHub_Request" method="GET" path="/x"
                      doc:name="mockable request (throws in tests)" doc:id="geh-helper-0001a" />
        <error-handler ref="global-error-handler" doc:name="global-error-handler" />
    </flow>

    <flow name="teh-mcp-raiser" doc:id="geh-helper-0002">
        <http:request config-ref="GitHub_Request" method="GET" path="/x"
                      doc:name="mockable request (throws in tests)" doc:id="geh-helper-0002a" />
        <error-handler ref="mcp-error-handler" doc:name="mcp-error-handler" />
    </flow>

    <!-- ═══════════════ global-error-handler tests ═══════════════ -->
    <munit:test name="geh-apikit-bad-request-400" doc:id="geh-test-0001" description="APIKIT:BAD_REQUEST maps to 400">
        <munit:behavior>
            <munit-tools:mock-when doc:name="throw APIKIT:BAD_REQUEST" processor="http:request">
                <munit-tools:then-return><munit-tools:error typeId="APIKIT:BAD_REQUEST" /></munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="teh-global-raiser" doc:name="raise" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="httpStatus 400" expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(400)]" />
            <munit-tools:assert-that doc:name="code 400" expression="#[payload.code]" is="#[MunitTools::equalTo('400')]" />
        </munit:validation>
    </munit:test>

