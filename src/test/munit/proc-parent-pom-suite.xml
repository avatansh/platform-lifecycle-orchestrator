    <!--
        proc-parent-pom-suite.xml
        Coverage for pf-upgrade-parent-pom (process/parent-pom-upgrade.xml) plus its REST + MCP
        wrappers, on the "already compliant" (no edits) path so no commit/PR/notify is required.
        owner/repo/branch are supplied so the default-branch discovery HTTP never fires; the two
        GitHub GETs (HEAD commit, parent pom) are mocked by path. The parent pom manages no
        matrix connectors, so rewriteParentPom returns zero edits and a 200 no-change result.
    -->
    <munit:config name="proc-parent-pom-suite" doc:id="ppp-suite-0001" />

    <munit:test name="parentpom-no-edits" doc:id="ppp-test-0001"
                description="pf-upgrade-parent-pom returns upgraded=false when the parent pom already meets the matrix">
        <munit:behavior>
            <!-- Generic fallback so Slack + Jira-comment notifications resolve; the specific
                 GitHub GET mocks below (declared later) override this for their exact paths. -->
            <munit-tools:mock-when doc:name="mock http fallback (slack/jira)" processor="http:request">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[{}]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock GET HEAD commit" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="/repos/po/pr/commits/main" attributeName="path" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ sha: 'PSHA' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="headCommit" value="#[{ sha: 'PSHA' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock GET parent pom" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="/repos/po/pr/contents/pom.xml" attributeName="path" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[%dw 2.0
import toBase64 from dw::core::Binaries
output application/java
var pom = &quot;&lt;project xmlns='http://maven.apache.org/POM/4.0.0'&gt;&lt;modelVersion&gt;4.0.0&lt;/modelVersion&gt;&lt;groupId&gt;c&lt;/groupId&gt;&lt;artifactId&gt;parent&lt;/artifactId&gt;&lt;version&gt;1&lt;/version&gt;&lt;packaging&gt;pom&lt;/packaging&gt;&lt;/project&gt;&quot;
---
{ content: toBase64(pom as Binary), encoding: 'base64' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="pomResp" value="#[%dw 2.0
import toBase64 from dw::core::Binaries
output application/java
var pom = &quot;&lt;project xmlns='http://maven.apache.org/POM/4.0.0'&gt;&lt;modelVersion&gt;4.0.0&lt;/modelVersion&gt;&lt;groupId&gt;c&lt;/groupId&gt;&lt;artifactId&gt;parent&lt;/artifactId&gt;&lt;version&gt;1&lt;/version&gt;&lt;packaging&gt;pom&lt;/packaging&gt;&lt;/project&gt;&quot;
---
{ content: toBase64(pom as Binary), encoding: 'base64' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS store" processor="os:store">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[null]" /></munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="owner" value="po" doc:name="PV owner" />
            <set-variable variableName="repo" value="pr" doc:name="PV repo" />
            <set-variable variableName="branch" value="main" doc:name="PV branch" />
            <set-variable variableName="jiraTicketId" value="J1U-9" doc:name="PV jiraTicketId" />
            <flow-ref name="pf-upgrade-parent-pom" doc:name="invoke pf-upgrade-parent-pom" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="not upgraded" expression="#[payload.upgraded]" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that doc:name="no edits" expression="#[sizeOf(payload.edits default [])]" is="#[MunitTools::equalTo(0)]" />
            <munit-tools:assert-that doc:name="jobId returned" expression="#[payload.jobId]" is="#[MunitTools::notNullValue()]" />
            <munit-tools:assert-that doc:name="status NO_CHANGE" expression="#[payload.status]" is="#[MunitTools::equalTo('NO_CHANGE')]" />
            <munit-tools:assert-that doc:name="jiraUrl built" expression="#[payload.jiraUrl endsWith '/browse/J1U-9']" is="#[MunitTools::equalTo(true)]" />
        </munit:validation>
    </munit:test>

