            <flow-ref name="post:\jobs:application\json:platform-lifecycle-orchestrator-config" doc:name="invoke post jobs route" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="jobId returned" expression="#[payload.jobId]" is="#[MunitTools::notNullValue()]" />
