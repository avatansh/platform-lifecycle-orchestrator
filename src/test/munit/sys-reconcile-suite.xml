<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/http         http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os           http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <!--
        sys-reconcile-suite.xml
        Coverage for the pf-reconcile scheduled sweep (system/reconcile.xml). The scheduler source
        is ignored when the flow is invoked via flow-ref. os:retrieve-all-keys is mocked to control
        which job keys are swept, and each job record is returned via the os:retrieve mock.
    -->
    <munit:config name="sys-reconcile-suite" doc:id="src-suite-0001" />

    <!-- Early-stage orphan (PROCESSING + stale) → FAILED_INTERRUPTED + lock released. -->
    <munit:test name="reconcile-early-stage-orphan" doc:id="src-test-0001"
                description="pf-reconcile finalises a stale early-stage job as FAILED_INTERRUPTED">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock all keys" processor="os:retrieve-all-keys">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[['job-early']]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ appName: 'orphan-app', status: 'PROCESSING', updatedAt: '2000-01-01T00:00:00Z' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="rec" value="#[{ appName: 'orphan-app', status: 'PROCESSING', updatedAt: '2000-01-01T00:00:00Z' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS store" processor="os:store">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[null]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS contains (no lock)" processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[false]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="lockPresent" value="#[false]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="pf-reconcile" doc:name="invoke pf-reconcile" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="one job fixed" expression="#[vars.fixed]" is="#[MunitTools::equalTo(1)]" />
        </munit:validation>
    </munit:test>

    <!-- Non-reconcilable (DEPLOYED, fresh) → otherwise no-op. -->
    <munit:test name="reconcile-not-stale-noop" doc:id="src-test-0002"
                description="pf-reconcile leaves a fresh/terminal job untouched">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock all keys" processor="os:retrieve-all-keys">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[['job-fresh']]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ appName: 'fresh-app', status: 'DEPLOYED', updatedAt: (now() as String) }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="rec" value="#[{ appName: 'fresh-app', status: 'DEPLOYED', updatedAt: (now() as String) }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="pf-reconcile" doc:name="invoke pf-reconcile" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="nothing fixed" expression="#[vars.fixed]" is="#[MunitTools::equalTo(0)]" />
        </munit:validation>
    </munit:test>

    <!-- PR_OPEN stale + PR merged → DEPLOYING. -->
    <munit:test name="reconcile-pr-merged" doc:id="src-test-0003"
                description="pf-reconcile advances a stale PR_OPEN job to DEPLOYING when the PR merged">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock all keys" processor="os:retrieve-all-keys">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[['job-prm']]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ appName: 'prm-app', status: 'PR_OPEN', prNumber: 5, coords: { owner: 'o', repo: 'r' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="rec" value="#[{ appName: 'prm-app', status: 'PR_OPEN', prNumber: 5, coords: { owner: 'o', repo: 'r' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock GET PR (merged)" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ merged: true, state: 'closed' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="pr" value="#[{ merged: true, state: 'closed' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS store" processor="os:store">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[null]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="pf-reconcile" doc:name="invoke pf-reconcile" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="one job fixed" expression="#[vars.fixed]" is="#[MunitTools::equalTo(1)]" />
        </munit:validation>
    </munit:test>

    <!-- PR_OPEN stale + PR closed unmerged → CLOSED + lock released (parity with webhook). -->
    <munit:test name="reconcile-pr-closed-unmerged" doc:id="src-test-0004"
                description="pf-reconcile finalises a stale PR_OPEN job as CLOSED when the PR was closed unmerged">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock all keys" processor="os:retrieve-all-keys">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[['job-prc']]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ appName: 'prc-app', status: 'PR_OPEN', prNumber: 6, coords: { owner: 'o', repo: 'r' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="rec" value="#[{ appName: 'prc-app', status: 'PR_OPEN', prNumber: 6, coords: { owner: 'o', repo: 'r' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock GET PR (closed unmerged)" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ merged: false, state: 'closed' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="pr" value="#[{ merged: false, state: 'closed' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS store" processor="os:store">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[null]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS remove" processor="os:remove">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[null]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS contains (lock held)" processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[true]" />
                    <munit-tools:variables><munit-tools:variable key="lockPresent" value="#[true]" /></munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="pf-reconcile" doc:name="invoke pf-reconcile" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="one job fixed" expression="#[vars.fixed]" is="#[MunitTools::equalTo(1)]" />
        </munit:validation>
    </munit:test>

    <!-- PR_OPEN stale + PR still open → no-op (otherwise). -->
    <munit:test name="reconcile-pr-still-open" doc:id="src-test-0005"
                description="pf-reconcile leaves a stale PR_OPEN job untouched while the PR is still open">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock all keys" processor="os:retrieve-all-keys">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[['job-pro']]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ appName: 'pro-app', status: 'PR_OPEN', prNumber: 7, coords: { owner: 'o', repo: 'r' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="rec" value="#[{ appName: 'pro-app', status: 'PR_OPEN', prNumber: 7, coords: { owner: 'o', repo: 'r' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock GET PR (still open)" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ merged: false, state: 'open' }]" />
                    <munit-tools:variables><munit-tools:variable key="pr" value="#[{ merged: false, state: 'open' }]" /></munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="pf-reconcile" doc:name="invoke pf-reconcile" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="nothing fixed" expression="#[vars.fixed]" is="#[MunitTools::equalTo(0)]" />
        </munit:validation>
    </munit:test>

    <!-- DEPLOYING stale + platform healthy → DEPLOYED + lock released. -->
    <munit:test name="reconcile-deploying-platform-healthy" doc:id="src-test-0006"
                description="pf-reconcile confirms a stale DEPLOYING job as DEPLOYED when the platform reports healthy">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock all keys" processor="os:retrieve-all-keys">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[['job-dph']]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ appName: 'dep-app-h', status: 'DEPLOYING', environment: '', coords: { owner: 'o', repo: 'r', orgId: 'org-h' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="rec" value="#[{ appName: 'dep-app-h', status: 'DEPLOYING', environment: '', coords: { owner: 'o', repo: 'r', orgId: 'org-h' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <!-- One http mock for all three verify calls; sets vars.deployments (deployments call target). -->
            <munit-tools:mock-when doc:name="mock Anypoint HTTP (healthy)" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ data: [] }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="deployments" value="#[{ items: [{ name: 'dep-app-h', application: { status: 'RUNNING' } }] }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS store" processor="os:store">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[null]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS remove" processor="os:remove">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[null]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS contains (lock held)" processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[true]" />
                    <munit-tools:variables><munit-tools:variable key="lockPresent" value="#[true]" /></munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="pf-reconcile" doc:name="invoke pf-reconcile" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="one job fixed" expression="#[vars.fixed]" is="#[MunitTools::equalTo(1)]" />
        </munit:validation>
    </munit:test>

    <!-- DEPLOYING stale + platform unhealthy → FAILED_DEPLOY + lock released. -->
    <munit:test name="reconcile-deploying-platform-unhealthy" doc:id="src-test-0007"
                description="pf-reconcile fails a stale DEPLOYING job when the platform reports an unhealthy status">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock all keys" processor="os:retrieve-all-keys">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[['job-dpu']]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ appName: 'dep-app-u', status: 'DEPLOYING', environment: '', coords: { owner: 'o', repo: 'r', orgId: 'org-u' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="rec" value="#[{ appName: 'dep-app-u', status: 'DEPLOYING', environment: '', coords: { owner: 'o', repo: 'r', orgId: 'org-u' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock Anypoint HTTP (unhealthy)" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ data: [] }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="deployments" value="#[{ items: [{ name: 'dep-app-u', application: { status: 'UNDEPLOYED' } }] }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS store" processor="os:store">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[null]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS remove" processor="os:remove">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[null]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS contains (lock held)" processor="os:contains">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[true]" />
                    <munit-tools:variables><munit-tools:variable key="lockPresent" value="#[true]" /></munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="pf-reconcile" doc:name="invoke pf-reconcile" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="one job fixed" expression="#[vars.fixed]" is="#[MunitTools::equalTo(1)]" />
        </munit:validation>
    </munit:test>

    <!-- DEPLOYING stale + platform unverified (name mismatch) → leave (no-op). -->
    <munit:test name="reconcile-deploying-platform-unverified" doc:id="src-test-0008"
                description="pf-reconcile leaves a stale DEPLOYING job untouched when the platform cannot confirm it">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock all keys" processor="os:retrieve-all-keys">
                <munit-tools:then-return><munit-tools:payload mediaType="application/java" value="#[['job-dpn']]" /></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock OS retrieve job" processor="os:retrieve">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ appName: 'dep-app-n', status: 'DEPLOYING', environment: '', coords: { owner: 'o', repo: 'r', orgId: 'org-n' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="rec" value="#[{ appName: 'dep-app-n', status: 'DEPLOYING', environment: '', coords: { owner: 'o', repo: 'r', orgId: 'org-n' }, updatedAt: '2000-01-01T00:00:00Z' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock Anypoint HTTP (name mismatch)" processor="http:request">
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ data: [] }]" />
                    <munit-tools:variables>
                        <munit-tools:variable key="deployments" value="#[{ items: [{ name: 'some-other-app', application: { status: 'RUNNING' } }] }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="pf-reconcile" doc:name="invoke pf-reconcile" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="nothing fixed" expression="#[vars.fixed]" is="#[MunitTools::equalTo(0)]" />
        </munit:validation>
    </munit:test>

</mule>
