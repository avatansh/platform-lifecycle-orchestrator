      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/http         http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <!--
        proc-assess-suite.xml
        Coverage for the pf-assess-app pipeline (process/post-jobs-assess.xml) plus its REST and
        MCP wrappers. A standalone (no parent) app is used so the parent/grandparent Contents API
        calls never fire. Coordinates are supplied on the request body (owner/repo/branch/appPath)
        so pf-resolve-coordinates resolves offline (no GitHub default-branch discovery).

        Three GitHub calls are mocked by path:
          1. GET /repos/{o}/{r}/commits/{branch}   -> HEAD commit sha
          2. GET /repos/{o}/{r}/git/trees/{sha}    -> recursive tree (pom.xml only)
          3. GET /repos/{o}/{r}/contents/pom.xml   -> base64 app pom (standalone)
        The app pom declares no dependencies, so missingFromMatrix is empty and the async
        pf-notify-missing-connectors short-circuits (no Slack HTTP).
    -->
    <munit:config name="proc-assess-suite" doc:id="pas-suite-0001" />

    <!-- Shared behaviour: mock the three GitHub GETs by path. -->
    <munit:test name="assess-pf-assess-app-standalone" doc:id="pas-test-0001"
                description="pf-assess-app resolves a standalone app, fetches commit/tree/pom and returns an AssessmentResult">
        <munit:behavior>
            <munit-tools:mock-when doc:name="mock GET commit" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="/repos/covorg/covrepo/commits/main" attributeName="path" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[{ sha: 'COVSHA' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock GET tree" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="/repos/covorg/covrepo/git/trees/COVSHA" attributeName="path" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[{ sha: 'TREESHA', truncated: false, tree: [ { path: 'pom.xml', 'type': 'blob' } ] }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="mock GET app pom" processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="/repos/covorg/covrepo/contents/pom.xml" attributeName="path" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[%dw 2.0
import toBase64 from dw::core::Binaries
output application/java
var pom = &quot;&lt;project xmlns='http://maven.apache.org/POM/4.0.0'&gt;&lt;modelVersion&gt;4.0.0&lt;/modelVersion&gt;&lt;groupId&gt;c&lt;/groupId&gt;&lt;artifactId&gt;a&lt;/artifactId&gt;&lt;version&gt;1.0.0&lt;/version&gt;&lt;properties&gt;&lt;app.runtime&gt;4.6.0&lt;/app.runtime&gt;&lt;java.version&gt;8&lt;/java.version&gt;&lt;/properties&gt;&lt;/project&gt;&quot;
---
{ content: toBase64(pom as Binary), encoding: 'base64' }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <set-variable variableName="appName" value="assess-cov-app" doc:name="PV appName" />
            <set-variable variableName="environment" value="Sandbox" doc:name="PV environment" />
            <set-variable variableName="requestBody"
                          value="#[{ owner: 'covorg', repo: 'covrepo', branch: 'main', appPath: '.' }]"
                          doc:name="PV requestBody" />
            <flow-ref name="pf-assess-app" doc:name="invoke pf-assess-app" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="appName echoed" expression="#[payload.appName]" is="#[MunitTools::equalTo('assess-cov-app')]" />
            <munit-tools:assert-that doc:name="changePlan present" expression="#[payload.changePlan]" is="#[MunitTools::notNullValue()]" />
            <munit-tools:assert-that doc:name="currentRuntime read from pom" expression="#[payload.currentRuntime]" is="#[MunitTools::equalTo('4.6.0')]" />
        </munit:validation>
    </munit:test>

