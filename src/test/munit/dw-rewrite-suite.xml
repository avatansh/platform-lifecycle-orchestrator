<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core          http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit         http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools   http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
        http://www.mulesoft.org/schema/mule/ee/core       http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
        dw-rewrite-suite.xml
        Unit tests for the four DataWeave rewrite library modules:
          · dwl::rewritePomProperties  — surgical <tag>value</tag> replacement in pom.xml text
          · dwl::rewriteMuleArtifact   — update mule-artifact.json preserving other keys
          · dwl::rewriteCiWorkflow     — bump java-version in a GitHub Actions YAML workflow
          · dwl::rewriteMunitRuntime   — replace <runtimeVersion>…</runtimeVersion> in pom text

        All tests are pure DataWeave — no connectors, no Object Store, no HTTP mocks needed.
        Each test uses an ee:transform to invoke the module function and stores the result in
        vars.result, then asserts directly on that variable.
    -->
    <munit:config name="dw-rewrite-suite" doc:id="dw-suite-0001" />

    <!-- ══════════════════════════════════════════════════════════════════════════
         rewritePomProperties
         ══════════════════════════════════════════════════════════════════════════ -->

    <!--
        Test 1: Single property rewrite — app.runtime updated, other tags untouched.
    -->
    <munit:test name="rewritePomProperties-single-property"
                doc:id="dw-test-0001"
                description="rewritePomProperties updates a single target property and leaves all other tags unchanged">

        <munit:execution>
            <ee:transform doc:name="DW invoke rewritePomProperties (single)"
                          doc:id="dw-test-0001-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewritePomProperties from dwl::rewritePomProperties
output application/java
var samplePom = "<?xml version=\"1.0\"?>
<project>
  <properties>
    <app.runtime>4.6.0</app.runtime>
    <java.version>8</java.version>
    <mule.maven.plugin.version>4.5.0</mule.maven.plugin.version>
  </properties>
</project>"
---
rewritePomProperties(samplePom, [
    { property: "app.runtime", to: "4.9.18" }
])]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>

        <munit:validation>
            <!-- Updated property must contain new value -->
            <munit-tools:assert-that
                doc:name="assert app.runtime updated"
                expression="#[vars.result]"
                is="#[MunitTools::containsString('&lt;app.runtime&gt;4.9.18&lt;/app.runtime&gt;')]" />
            <!-- Untouched properties must retain original values -->
            <munit-tools:assert-that
                doc:name="assert java.version unchanged"
                expression="#[vars.result]"
                is="#[MunitTools::containsString('&lt;java.version&gt;8&lt;/java.version&gt;')]" />
            <munit-tools:assert-that
                doc:name="assert old app.runtime value absent"
                expression="#[vars.result contains '4.6.0']"
                is="#[MunitTools::equalTo(false)]" />
        </munit:validation>

    </munit:test>

    <!--
        Test 2: Multiple property rewrites in one call — both updated, unrelated tag preserved.
    -->
    <munit:test name="rewritePomProperties-multiple-properties"
                doc:id="dw-test-0002"
                description="rewritePomProperties updates multiple target properties in a single pass">

        <munit:execution>
            <ee:transform doc:name="DW invoke rewritePomProperties (multiple)"
                          doc:id="dw-test-0002-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewritePomProperties from dwl::rewritePomProperties
output application/java
var samplePom = "<properties>
  <app.runtime>4.6.0</app.runtime>
  <java.version>8</java.version>
  <muleHttpConnectorVersion>1.9.0</muleHttpConnectorVersion>
  <unrelated.tag>keep-me</unrelated.tag>
</properties>"
---
rewritePomProperties(samplePom, [
    { property: "app.runtime",              to: "4.9.18" },
    { property: "java.version",             to: "17"     },
    { property: "muleHttpConnectorVersion", to: "1.11.3" }
])]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert app.runtime → 4.9.18"
                expression="#[vars.result]"
                is="#[MunitTools::containsString('&lt;app.runtime&gt;4.9.18&lt;/app.runtime&gt;')]" />
            <munit-tools:assert-that
                doc:name="assert java.version → 17"
                expression="#[vars.result]"
                is="#[MunitTools::containsString('&lt;java.version&gt;17&lt;/java.version&gt;')]" />
            <munit-tools:assert-that
                doc:name="assert muleHttpConnectorVersion → 1.11.3"
                expression="#[vars.result]"
                is="#[MunitTools::containsString('&lt;muleHttpConnectorVersion&gt;1.11.3&lt;/muleHttpConnectorVersion&gt;')]" />
            <munit-tools:assert-that
                doc:name="assert unrelated tag preserved"
                expression="#[vars.result]"
                is="#[MunitTools::containsString('&lt;unrelated.tag&gt;keep-me&lt;/unrelated.tag&gt;')]" />
        </munit:validation>

    </munit:test>

    <!--
        Test 3: No matching property — original text returned verbatim (no changes).
    -->
    <munit:test name="rewritePomProperties-no-match-is-noop"
                doc:id="dw-test-0003"
                description="rewritePomProperties returns original text unchanged when no edit tag exists">

        <munit:execution>
            <ee:transform doc:name="DW invoke rewritePomProperties (no match)"
                          doc:id="dw-test-0003-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewritePomProperties from dwl::rewritePomProperties
output application/java
var samplePom = "<properties><other.tag>some-value</other.tag></properties>"
---
rewritePomProperties(samplePom, [
    { property: "app.runtime", to: "4.9.18" }
])]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert text unchanged"
                expression="#[vars.result]"
                is="#[MunitTools::equalTo('&lt;properties&gt;&lt;other.tag&gt;some-value&lt;/other.tag&gt;&lt;/properties&gt;')]" />
        </munit:validation>

    </munit:test>

    <!-- ══════════════════════════════════════════════════════════════════════════
         rewriteMuleArtifact
         ══════════════════════════════════════════════════════════════════════════ -->

    <!--
        Test 4: File with only minMuleVersion — javaSpecificationVersions must be ADDED.
    -->
    <munit:test name="rewriteMuleArtifact-adds-javaSpecVersions"
                doc:id="dw-test-0004"
                description="rewriteMuleArtifact adds javaSpecificationVersions when not present and updates minMuleVersion">

        <munit:execution>
            <ee:transform doc:name="DW invoke rewriteMuleArtifact (add java spec)"
                          doc:id="dw-test-0004-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewriteMuleArtifact from dwl::rewriteMuleArtifact
output application/java
var originalText = "{\"minMuleVersion\": \"4.4.0\"}"
---
rewriteMuleArtifact(originalText, "4.9.0", ["17"])]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert minMuleVersion updated"
                expression="#[(read(vars.result, 'application/json')).minMuleVersion]"
                is="#[MunitTools::equalTo('4.9.0')]" />
            <munit-tools:assert-that
                doc:name="assert javaSpecificationVersions added"
                expression="#[(read(vars.result, 'application/json')).javaSpecificationVersions[0]]"
                is="#[MunitTools::equalTo('17')]" />
        </munit:validation>

    </munit:test>

    <!--
        Test 5: File with existing keys — all are preserved, owned keys updated.
    -->
    <munit:test name="rewriteMuleArtifact-preserves-other-keys"
                doc:id="dw-test-0005"
                description="rewriteMuleArtifact preserves all keys not owned by the rewrite function">

        <munit:execution>
            <ee:transform doc:name="DW invoke rewriteMuleArtifact (preserve keys)"
                          doc:id="dw-test-0005-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewriteMuleArtifact from dwl::rewriteMuleArtifact
output application/java
var originalText = "{\"minMuleVersion\": \"4.4.0\", \"javaSpecificationVersions\": [\"8\"], \"name\": \"my-app\", \"secureProperties\": [\"encrypt.key\"]}"
---
rewriteMuleArtifact(originalText, "4.9.0", ["17"])]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>

        <munit:validation>
            <ee:transform doc:name="DW parse result JSON" doc:id="dw-test-0005-parse">
                <ee:variables>
                    <ee:set-variable variableName="parsed">#[read(vars.result, 'application/json')]</ee:set-variable>
                </ee:variables>
            </ee:transform>
            <munit-tools:assert-that
                doc:name="assert minMuleVersion = 4.9.0"
                expression="#[vars.parsed.minMuleVersion]"
                is="#[MunitTools::equalTo('4.9.0')]" />
            <munit-tools:assert-that
                doc:name="assert javaSpecificationVersions = [17]"
                expression="#[vars.parsed.javaSpecificationVersions[0]]"
                is="#[MunitTools::equalTo('17')]" />
            <munit-tools:assert-that
                doc:name="assert name preserved"
                expression="#[vars.parsed.name]"
                is="#[MunitTools::equalTo('my-app')]" />
            <munit-tools:assert-that
                doc:name="assert secureProperties preserved"
                expression="#[vars.parsed.secureProperties[0]]"
                is="#[MunitTools::equalTo('encrypt.key')]" />
        </munit:validation>

    </munit:test>

    <!-- ══════════════════════════════════════════════════════════════════════════
         rewriteCiWorkflow
         ══════════════════════════════════════════════════════════════════════════ -->

    <!--
        Test 6: java-version with single-quotes — bumped, surrounding chars preserved.
    -->
    <munit:test name="rewriteCiWorkflow-quoted-java-version"
                doc:id="dw-test-0006"
                description="rewriteCiWorkflow bumps java-version when wrapped in single quotes">

        <munit:execution>
            <ee:transform doc:name="DW invoke rewriteCiWorkflow (quoted)"
                          doc:id="dw-test-0006-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewriteCiWorkflow from dwl::rewriteCiWorkflow
output application/java
var sampleYaml = "      - name: Set up JDK\n        uses: actions/setup-java@v3\n        with:\n          java-version: '8'\n          distribution: 'temurin'"
---
rewriteCiWorkflow(sampleYaml, "17")]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert java-version bumped to 17"
                expression="#[vars.result]"
                is="#[MunitTools::containsString(&quot;java-version: '17'&quot;)]" />
            <munit-tools:assert-that
                doc:name="assert old value 8 absent"
                expression="#[vars.result contains &quot;java-version: '8'&quot;]"
                is="#[MunitTools::equalTo(false)]" />
        </munit:validation>

    </munit:test>

    <!--
        Test 7: java-version without quotes — bumped, no quotes added/removed.
    -->
    <munit:test name="rewriteCiWorkflow-unquoted-java-version"
                doc:id="dw-test-0007"
                description="rewriteCiWorkflow bumps java-version when unquoted">

        <munit:execution>
            <ee:transform doc:name="DW invoke rewriteCiWorkflow (unquoted)"
                          doc:id="dw-test-0007-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewriteCiWorkflow from dwl::rewriteCiWorkflow
output application/java
var sampleYaml = "          java-version: 11\n          distribution: temurin"
---
rewriteCiWorkflow(sampleYaml, "17")]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert java-version: 17 present"
                expression="#[vars.result]"
                is="#[MunitTools::containsString('java-version: 17')]" />
            <munit-tools:assert-that
                doc:name="assert java-version: 11 absent"
                expression="#[vars.result contains 'java-version: 11']"
                is="#[MunitTools::equalTo(false)]" />
        </munit:validation>

    </munit:test>

    <!-- ══════════════════════════════════════════════════════════════════════════
         rewriteMunitRuntime
         ══════════════════════════════════════════════════════════════════════════ -->

    <!--
        Test 8: runtimeVersion element present — value replaced.
    -->
    <munit:test name="rewriteMunitRuntime-replaces-version"
                doc:id="dw-test-0008"
                description="rewriteMunitRuntime replaces the runtimeVersion element value">

        <munit:execution>
            <ee:transform doc:name="DW invoke rewriteMunitRuntime"
                          doc:id="dw-test-0008-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewriteMunitRuntime from dwl::rewriteMunitRuntime
output application/java
var samplePom = "<configuration>
  <runtimeVersion>4.6.0</runtimeVersion>
  <coverageReportFormats>
    <coverageReportFormat>html</coverageReportFormat>
  </coverageReportFormats>
</configuration>"
---
rewriteMunitRuntime(samplePom, "4.9.18")]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert new runtimeVersion present"
                expression="#[vars.result]"
                is="#[MunitTools::containsString('&lt;runtimeVersion&gt;4.9.18&lt;/runtimeVersion&gt;')]" />
            <munit-tools:assert-that
                doc:name="assert old runtimeVersion absent"
                expression="#[vars.result contains '4.6.0']"
                is="#[MunitTools::equalTo(false)]" />
            <!-- Surrounding configuration must be preserved -->
            <munit-tools:assert-that
                doc:name="assert coverageReportFormat preserved"
                expression="#[vars.result]"
                is="#[MunitTools::containsString('coverageReportFormat')]" />
        </munit:validation>

    </munit:test>

    <!--
        Test 9: runtimeVersion element absent — original text returned unchanged (no-op).
    -->
    <munit:test name="rewriteMunitRuntime-absent-is-noop"
                doc:id="dw-test-0009"
                description="rewriteMunitRuntime returns original text unchanged when runtimeVersion element is absent">

        <munit:execution>
            <ee:transform doc:name="DW invoke rewriteMunitRuntime (absent)"
                          doc:id="dw-test-0009-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewriteMunitRuntime from dwl::rewriteMunitRuntime
output application/java
var samplePom = "<configuration><threads>4</threads></configuration>"
---
rewriteMunitRuntime(samplePom, "4.9.18")]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                doc:name="assert text unchanged"
                expression="#[vars.result]"
                is="#[MunitTools::equalTo('&lt;configuration&gt;&lt;threads&gt;4&lt;/threads&gt;&lt;/configuration&gt;')]" />
        </munit:validation>

    </munit:test>

    <!-- ══════════════════════════════════════════════════════════════════════════
         rewritePomProperties :: add-if-absent (appOverride)
         ══════════════════════════════════════════════════════════════════════════ -->

    <!--
        Test 10: an addIfAbsent edit whose tag is missing is INSERTED into <properties>;
        an addIfAbsent edit whose tag is present is REPLACED (not duplicated); a plain edit
        (no flag) whose tag is missing stays a no-op.
    -->
    <munit:test name="rewritePomProperties-add-if-absent"
                doc:id="dw-test-0010"
                description="rewritePomProperties inserts a flagged absent property, replaces a present one, and ignores an unflagged absent one">
        <munit:execution>
            <ee:transform doc:name="DW invoke rewritePomProperties (add-if-absent)" doc:id="dw-test-0010-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewritePomProperties from dwl::rewritePomProperties
output application/java
var samplePom = "<project>
  <properties>
    <app.runtime>4.6.0</app.runtime>
  </properties>
</project>"
---
rewritePomProperties(samplePom, [
    { property: "app.runtime",  to: "4.9.18", addIfAbsent: true },
    { property: "munit.version", to: "3.6.3", addIfAbsent: true },
    { property: "should.not.appear", to: "9.9.9" }
])]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="present property replaced" expression="#[vars.result]" is="#[MunitTools::containsString('&lt;app.runtime&gt;4.9.18&lt;/app.runtime&gt;')]" />
            <munit-tools:assert-that doc:name="absent flagged property inserted" expression="#[vars.result]" is="#[MunitTools::containsString('&lt;munit.version&gt;3.6.3&lt;/munit.version&gt;')]" />
            <munit-tools:assert-that doc:name="unflagged absent property not added" expression="#[vars.result contains 'should.not.appear']" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that doc:name="properties block intact" expression="#[vars.result]" is="#[MunitTools::containsString('&lt;/properties&gt;')]" />
        </munit:validation>
    </munit:test>

    <!-- ══════════════════════════════════════════════════════════════════════════
         rewriteDepVersions :: ref→literal, literal replace, absent→add (appOverride)
         ══════════════════════════════════════════════════════════════════════════ -->

    <!--
        Test 11: for a matched dependency, a property-ref version is replaced with the pinned literal,
        an inline literal is replaced, and a BOM-managed dependency (no <version>) gets one added.
    -->
    <munit:test name="rewriteDepVersions-pin-cases"
                doc:id="dw-test-0011"
                description="rewriteDepVersions replaces property-ref/literal versions and adds a version to a BOM-managed dependency">
        <munit:execution>
            <ee:transform doc:name="DW invoke rewriteDepVersions (pin cases)" doc:id="dw-test-0011-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewriteDepVersions from dwl::rewriteDepVersions
output application/java
var samplePom = "<dependencies>
  <dependency><groupId>org.mule.connectors</groupId><artifactId>mule-http-connector</artifactId><version>\u0024{http.connector.version}</version><classifier>mule-plugin</classifier></dependency>
  <dependency><groupId>org.mule.modules</groupId><artifactId>mule-apikit-module</artifactId><version>1.6.0</version></dependency>
  <dependency><groupId>org.mule.connectors</groupId><artifactId>mule-sockets-connector</artifactId><classifier>mule-plugin</classifier></dependency>
</dependencies>"
---
rewriteDepVersions(samplePom, [
    { groupId: "org.mule.connectors", artifactId: "mule-http-connector",    to: "1.11.3" },
    { groupId: "org.mule.modules",    artifactId: "mule-apikit-module",     to: "1.11.8" },
    { groupId: "org.mule.connectors", artifactId: "mule-sockets-connector", to: "1.2.4"  }
])]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="http ref replaced with literal" expression="#[vars.result]" is="#[MunitTools::containsString('&lt;version&gt;1.11.3&lt;/version&gt;')]" />
            <munit-tools:assert-that doc:name="http ref no longer present" expression="#[vars.result contains 'http.connector.version']" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that doc:name="apikit literal replaced" expression="#[vars.result]" is="#[MunitTools::containsString('&lt;version&gt;1.11.8&lt;/version&gt;')]" />
            <munit-tools:assert-that doc:name="apikit old literal gone" expression="#[vars.result contains '1.6.0']" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that doc:name="sockets version added" expression="#[vars.result]" is="#[MunitTools::containsString('&lt;version&gt;1.2.4&lt;/version&gt;')]" />
            <munit-tools:assert-that doc:name="sockets classifier preserved" expression="#[vars.result]" is="#[MunitTools::containsString('mule-sockets-connector')]" />
        </munit:validation>
    </munit:test>

    <!-- ══════════════════════════════════════════════════════════════════════════
         rewriteMunitArgLines :: Tier-0 JPMS argLine stripping
         ══════════════════════════════════════════════════════════════════════════ -->

    <!--
        Test 12: JPMS argLines (add-opens / add-exports / add-modules) are stripped ONLY from
        MUnit plugin blocks; the MUnit plugin itself is retained and a non-MUnit plugin's argLine
        is left untouched.
    -->
    <munit:test name="rewriteMunitArgLines-strips-munit-jpms-flags"
                doc:id="dw-test-0012"
                description="rewriteMunitArgLines removes JPMS argLines from MUnit plugins only, preserving other plugins">
        <munit:execution>
            <ee:transform doc:name="DW invoke rewriteMunitArgLines" doc:id="dw-test-0012-exec">
                <ee:variables>
                    <ee:set-variable variableName="result"><![CDATA[%dw 2.0
import rewriteMunitArgLines from dwl::rewriteMunitArgLines
output application/java
var samplePom = "<build><plugins>
  <plugin><groupId>com.mulesoft.munit.tools</groupId><artifactId>munit-maven-plugin</artifactId><configuration><argLines><argLine>--add-opens java.base/java.lang=ALL-UNNAMED</argLine></argLines></configuration></plugin>
  <plugin><groupId>com.mulesoft.munit.tools</groupId><artifactId>munit-extensions-maven-plugin</artifactId><configuration><argLines><argLine>--add-modules java.se</argLine><argLine>-Dfoo=bar</argLine></argLines></configuration></plugin>
  <plugin><artifactId>some-other-plugin</artifactId><configuration><argLines><argLine>--add-opens keep.this=ALL-UNNAMED</argLine></argLines></configuration></plugin>
</plugins></build>"
---
rewriteMunitArgLines(samplePom, ["--add-opens", "--add-exports", "--add-modules"])]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="munit add-opens removed" expression="#[vars.result contains 'java.base/java.lang']" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that doc:name="munit add-modules removed" expression="#[vars.result contains 'java.se']" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that doc:name="munit non-jpms argLine kept" expression="#[vars.result]" is="#[MunitTools::containsString('-Dfoo=bar')]" />
            <munit-tools:assert-that doc:name="munit plugin retained" expression="#[vars.result]" is="#[MunitTools::containsString('munit-maven-plugin')]" />
            <munit-tools:assert-that doc:name="other plugin argLine untouched" expression="#[vars.result]" is="#[MunitTools::containsString('keep.this')]" />
        </munit:validation>
    </munit:test>

</mule>