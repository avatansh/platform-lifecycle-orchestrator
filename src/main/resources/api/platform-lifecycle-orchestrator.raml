#%RAML 1.0
title: Platform Lifecycle Orchestrator API
version: v1
mediaType: application/json
description: |
  The Platform Lifecycle Orchestrator API enables AI agents and automation tooling to manage the full lifecycle
  of MuleSoft application upgrades — from runtime and Java version assessments through automated code changes,
  pull request creation, and deployment tracking. Use this API to orchestrate zero-touch or low-touch
  platform migrations at scale.

types:

  ChangePlan:
    type: object
    properties:
      targetRuntime:
        type: string
      targetJavaVersion:
        type: string
      filesToChange:
        type: array
        items: string
      hasApiPolicies:
        type: boolean
      hasCustomJavaCode:
        type: boolean
      hasLookupFunction:
        type: boolean
      headSha:
        type: string
        required: false
        description: Git commit SHA of the HEAD used to derive this plan
      topology:
        type: string
        required: false
        description: Deployment topology descriptor (e.g. blue-green, rolling, canary)
      fileEdits:
        type: FileEdit[]
        required: false
        description: List of individual file-level edits included in this plan

  FileEdit:
    type: object
    description: Describes a single file-level change within a ChangePlan
    properties:
      path:
        type: string
        description: Repository-relative path of the file being changed
      operation:
        type: string
        enum: [ADD, MODIFY, DELETE, RENAME]
        description: Type of edit operation
      previousPath:
        type: string
        required: false
        description: Original path, populated only when operation is RENAME
      patchSummary:
        type: string
        required: false
        description: Brief description of what changed within the file

  AssessmentResult:
    type: object
    properties:
      appName:
        type: string
      currentRuntime:
        type: string
      currentJavaVersion:
        type: string
      changePlan:
        type: ChangePlan
      warnings:
        type: array
        items: string

  JobStatus:
    type: object
    properties:
      jobId:
        type: string
      status:
        type: string
        enum: [PROCESSING, ASSESSING, COMMITTING, COMMITTED, PR_OPEN, DEPLOYING, DEPLOYED, ROLLED_BACK, FAILED_ASSESS, FAILED_COMMIT, FAILED_CI, FAILED_DEPLOY]
      message:
        type: string
        required: false
        description: Human-readable detail or error description for the current status
      nextPollSeconds:
        type: integer
        required: false
        description: Suggested number of seconds to wait before polling again
      prUrl:
        type: string
        required: false
      branchName:
        type: string
        required: false
      completedAt:
        type: string
        required: false
      error:
        type: string
        required: false

  AssessRequest:
    type: object
    properties:
      appName:
        type: string
      environment:
        type: string
      jiraTicketId:
        type: string
        required: false

  JobRequest:
    type: object
    properties:
      appName:
        type: string
      environment:
        type: string
      jiraTicketId:
        type: string
      approvedChangePlan:
        type: ChangePlan

/jobs:
  /assess:
    post:
      description: Assess a deployed MuleSoft application for runtime and Java version upgrade readiness.
      body:
        application/json:
          type: AssessRequest
      responses:
        200:
          body:
            application/json:
              type: AssessmentResult

  post:
    description: Submit an approved migration job.
    body:
      application/json:
        type: JobRequest
    responses:
      202:
        body:
          application/json:
            type: object
            properties:
              jobId:
                type: string

  /{jobId}:
    uriParameters:
      jobId:
        type: string
    get:
      description: Retrieve the current status of a migration job.
      responses:
        200:
          body:
            application/json:
              type: JobStatus
        404:
          description: No job with the specified jobId exists.

/webhook:
  post:
    description: Receive GitHub pull request webhook events.
    body:
      application/json:
        type: object
    responses:
      200:
        description: Webhook event received and acknowledged.

  /cd-result:
    post:
      description: Receive CD pipeline result callbacks and update job status.
      body:
        application/json:
          type: object
      responses:
        200:
          description: CD result received and acknowledged.