#%RAML 1.0
title: Platform Lifecycle Orchestrator API
version: v1
mediaType: application/json
description: |
  The Platform Lifecycle Orchestrator API enables AI agents and automation tooling to manage the full lifecycle
  of MuleSoft application upgrades — from runtime and Java version assessments through automated code changes,
  pull request creation, and deployment tracking. Use this API to orchestrate zero-touch or low-touch
  platform migrations at scale.

types:

  ChangePlan:
    type: object
    properties:
      targetRuntime:
        type: string
      targetJavaVersion:
        type: string
      filesToChange:
        type: array
        items: string
      hasApiPolicies:
        type: boolean
      hasCustomJavaCode:
        type: boolean
      hasLookupFunction:
        type: boolean
      headSha:
        type: string
        required: false
        description: Git commit SHA of the HEAD used to derive this plan
      topology:
        type: string
        required: false
        description: Deployment topology descriptor (e.g. blue-green, rolling, canary)
      fileEdits:
        type: FileEdit[]
        required: false
        description: List of individual file-level edits included in this plan

  FileEdit:
    type: object
    description: |
      A single file-level edit computed by assess_app. This mirrors the engine's
      ACTUAL output shape (file / kind / from / to + optional coordinate fields), so
      the fileEdits returned by assess can be round-tripped verbatim into an
      approvedChangePlan without failing request validation. The upgrade worker keys
      off `kind` to decide how to apply each edit.
    properties:
      file:
        type: string
        description: |
          Repository-relative path of the file being edited. Under the default
          app-override strategy (upgrade.pomEditStrategy=appOverride) this is the app's
          OWN module pom — version overrides are written there so sibling modules that
          share a parent/BOM are not affected. Under the legacy inPlace strategy this may
          be a shared parent/BOM pom inherited by other modules (see the warnings array).
      kind:
        type: string
        enum: [pomProperty, depVersion, pluginVersion, munitRuntimeVersion, muleArtifactJson, ciWorkflow]
        description: |
          Category of edit, which tells the worker how to apply it:
          pomProperty (a <properties> value), depVersion / pluginVersion (an inline
          dependency/plugin version), munitRuntimeVersion (MUnit plugin runtime),
          muleArtifactJson (minMuleVersion + javaSpecificationVersions), ciWorkflow
          (target Java version in the CI workflow).
      property:
        type: string
        required: false
        description: For pomProperty/dependency/plugin edits, the Maven property or coordinate key involved
      groupId:
        type: string
        required: false
        description: Dependency groupId (present for depVersion edits)
      artifactId:
        type: string
        required: false
        description: Dependency artifactId (present for depVersion edits)
      pluginGroupId:
        type: string
        required: false
        description: Plugin groupId (present for pluginVersion edits)
      pluginArtifactId:
        type: string
        required: false
        description: Plugin artifactId (present for pluginVersion edits)
      from:
        type: any
        required: false
        description: |
          Current value before the edit. Usually a string (e.g. a version); for
          muleArtifactJson it is an object ({ minMuleVersion, javaSpecificationVersions }).
      to:
        type: any
        required: false
        description: Target value after the edit. Same shape as `from`.
      change:
        type: string
        required: false
        description: Flag/reason indicating why this edit is needed (e.g. the gating rule that triggered it)

  AssessmentResult:
    type: object
    properties:
      appName:
        type: string
      currentRuntime:
        type: string
      currentJavaVersion:
        type: string
      changePlan:
        type: ChangePlan
      warnings:
        type: array
        items: string

  JobStatus:
    type: object
    properties:
      jobId:
        type: string
      status:
        type: string
        enum: [PROCESSING, ASSESSING, COMMITTING, COMMITTED, PR_OPEN, MUNIT_FAILED, DEPLOYING, DEPLOYED, ROLLED_BACK, FAILED_ASSESS, FAILED_COMMIT, FAILED_CI, FAILED_DEPLOY, FAILED_INTERRUPTED]
        description: |
          Job lifecycle state. Most values are terminal or auto-advancing. MUNIT_FAILED is
          a NON-terminal, human-needed PAUSE: the app's MUnit suite failed in CI. The job
          waits (retained for 30 days) until a human fixes the tests and CI reports a test
          success (via POST /webhook/cd-result with stage=test, result=success), which
          resumes it. While MUNIT_FAILED, nextPollSeconds is large or omitted.
      message:
        type: string
        required: false
        description: Human-readable detail or error description for the current status
      nextPollSeconds:
        type: integer
        required: false
        description: Suggested number of seconds to wait before polling again
      prUrl:
        type: string
        required: false
      branchName:
        type: string
        required: false
      prNumber:
        type: integer
        required: false
        description: GitHub pull request number, populated once the PR is opened.
      completedAt:
        type: string
        required: false
      error:
        type: string
        required: false

  CoordinateOverrides:
    type: object
    description: |
      Optional per-request overrides for repository/platform coordinates. When omitted, the
      orchestrator resolves them from the app-registry, then convention defaults. For owner/repo/
      appPath/orgId the registry is authoritative and wins over these overrides; they take effect
      only for apps that are not in the registry.
    properties:
      branch:
        type: string
        required: false
        description: |
          Explicit branch to assess/upgrade for THIS request. Highest precedence — overrides the
          registry default and the repository's discovered default branch. Use when targeting a
          specific feature/release branch.
      owner:
        type: string
        required: false
        description: GitHub owner/org override (used only when the app is not in the registry).
      repo:
        type: string
        required: false
        description: GitHub repository name override (used only when the app is not in the registry).
      appPath:
        type: string
        required: false
        description: Path to the Mule module within the repo (e.g. "." for repo root).
      orgId:
        type: string
        required: false
        description: Anypoint organization ID override (used only when the app is not in the registry).

  CdResultRequest:
    type: object
    description: |
      CD/CI callback that updates a job. ONE endpoint serves two pipeline stages,
      distinguished by `stage`:
        - stage=deploy (default): deployment result from the CD pipeline
          (success -> DEPLOYED, failure -> FAILED_DEPLOY + rollback).
        - stage=test: MUnit (CI test) result. A failure parks the job in MUNIT_FAILED
          (Slack + Jira notified); a later success resumes the parked job.
      Authenticated via the X-CD-Signature-256 HMAC header (X-CD-Token accepted as a
      transitional fallback).
    properties:
      jobId:
        type: string
      result:
        type: string
        enum: [success, failure]
      stage:
        type: string
        required: false
        enum: [test, deploy]
        description: |
          Which pipeline stage this callback reports. Defaults to `deploy` when omitted,
          keeping existing CD callers backward-compatible. Use `test` to report the
          MUnit/CI outcome.
      deployUrl:
        type: string
        required: false
        description: Deployment URL (typically present on stage=deploy success).
      error:
        type: string
        required: false
        description: Human-readable failure detail (present on result=failure).

  AssessRequest:
    type: CoordinateOverrides
    properties:
      appName:
        type: string
      environment:
        type: string
      jiraTicketId:
        type: string
        required: false

  JobRequest:
    type: CoordinateOverrides
    properties:
      appName:
        type: string
      environment:
        type: string
      jiraTicketId:
        type: string
        required: false
        description: |
          Optional. Jira ticket ID to link this migration to. When present, progress/decision
          comments are posted to it and PR/Slack notifications include a link. When absent, the
          job still runs end-to-end with Jira integration simply skipped.
      approvedChangePlan:
        type: ChangePlan
        required: false
        description: |
          Optional, audit-only. The human-approved plan from assess_app, recorded on the job
          record for traceability. The upgrade worker re-runs assessment internally and drives
          the actual edits from its freshly-computed fileEdits — this value is NOT trusted for
          the edits themselves, so omitting it does not change the upgrade outcome.

/jobs:
  /assess:
    post:
      description: Assess a deployed MuleSoft application for runtime and Java version upgrade readiness.
      body:
        application/json:
          type: AssessRequest
      responses:
        200:
          body:
            application/json:
              type: AssessmentResult

  post:
    description: Submit an approved migration job.
    body:
      application/json:
        type: JobRequest
    responses:
      202:
        body:
          application/json:
            type: object
            properties:
              jobId:
                type: string

  /{jobId}:
    uriParameters:
      jobId:
        type: string
    get:
      description: Retrieve the current status of a migration job.
      responses:
        200:
          body:
            application/json:
              type: JobStatus
        404:
          description: No job with the specified jobId exists.

/webhook:
  post:
    description: Receive GitHub pull request webhook events.
    body:
      application/json:
        type: object
    responses:
      200:
        description: Webhook event received and acknowledged.

  /cd-result:
    post:
      description: |
        Receive CD/CI result callbacks and update job status. Handles both deployment
        results (stage=deploy, the default) and MUnit/CI test results (stage=test).
      body:
        application/json:
          type: CdResultRequest
      responses:
        200:
          description: CD/CI result received and acknowledged.