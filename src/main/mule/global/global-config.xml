<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:api-gateway="http://www.mulesoft.org/schema/mule/api-gateway"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:mcp="http://www.mulesoft.org/schema/mule/mcp"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd
        http://www.mulesoft.org/schema/mule/mcp http://www.mulesoft.org/schema/mule/mcp/current/mule-mcp.xsd">

    <!-- ===== Object Store v2 — partitioned stores ===== -->
    <!--
        All named stores below are PARTITIONS inside the single OSv2 allocation this app
        receives from CloudHub. Splitting them (rather than sharing one store with key
        prefixes) keeps each partition's key namespace clean — most importantly it lets
        pf-reconcile's retrieve-all-keys scan ONLY job records instead of paging through
        locks / de-dup / index keys (25 keys per GET). Note: the OSv2 TPS ceiling and
        monthly quota are per-app and SHARED across all partitions — splitting improves
        scan scope and TTL hygiene, it does not increase throughput budget.

        jobStore — job records. 30d rolling TTL; each os:store resets the window.
    -->
    <os:object-store name="jobStore"
                     doc:name="Job Store"
                     doc:id="a1b2c3d4-0001-0001-0001-000000000012"
                     persistent="true"
                     entryTtl="${osv2.jobTtlSeconds}"
                     entryTtlUnit="SECONDS"
                     maxEntries="10000"
                     expirationInterval="1"
                     expirationIntervalUnit="HOURS" />

    <!--
        locksStore — single-flight upgrade locks (key = appName). Short TTL acts as a
        safety net so a crashed worker cannot deadlock an app forever; locks are normally
        released explicitly when a job reaches a terminal state.
    -->
    <os:object-store name="locksStore"
                     doc:name="Locks Store"
                     doc:id="a1b2c3d4-0001-0001-0001-000000000014"
                     persistent="true"
                     entryTtl="${osv2.lockTtlSeconds}"
                     entryTtlUnit="SECONDS"
                     maxEntries="10000"
                     expirationInterval="10"
                     expirationIntervalUnit="MINUTES" />

    <!--
        idempotencyStore — GitHub webhook delivery de-duplication (key = delivery UUID).
        TTL only needs to outlive GitHub's redelivery window.
    -->
    <os:object-store name="idempotencyStore"
                     doc:name="Idempotency Store"
                     doc:id="a1b2c3d4-0001-0001-0001-000000000015"
                     persistent="true"
                     entryTtl="${osv2.idempotencyTtlSeconds}"
                     entryTtlUnit="SECONDS"
                     maxEntries="50000"
                     expirationInterval="1"
                     expirationIntervalUnit="HOURS" />

    <!--
        indexStore — branch→jobId correlation index (key = branchName). Must live as long
        as a job may still receive a PR-merge / CD webhook, so it tracks the job lifetime.
    -->
    <os:object-store name="indexStore"
                     doc:name="Index Store"
                     doc:id="a1b2c3d4-0001-0001-0001-000000000016"
                     persistent="true"
                     entryTtl="${osv2.indexTtlSeconds}"
                     entryTtlUnit="SECONDS"
                     maxEntries="10000"
                     expirationInterval="1"
                     expirationIntervalUnit="HOURS" />

    <!-- ===== Property Sources ===== -->
    <!-- Environment-specific non-sensitive properties: config-dev.yaml, config-prod.yaml, etc. -->
    <configuration-properties
        doc:name="Environment Config Properties"
        doc:id="a1b2c3d4-0001-0001-0001-000000000001"
        file="properties/config-${env}.yaml" />

    <!-- Global non-sensitive defaults shared across all environments -->
    <configuration-properties
        doc:name="Global Config Properties"
        doc:id="a1b2c3d4-0001-0001-0001-000000000002"
        file="properties/config.yaml" />

    <!-- ===== HTTP Listener ===== -->
    <!-- Plain HTTP — TLS termination is handled by the CloudHub 2.0 shared load balancer -->
    <http:listener-config
        name="apiHttpListenerConfig"
        doc:name="HTTP Listener Config"
        doc:id="a1b2c3d4-0001-0001-0001-000000000003">
        <http:listener-connection host="${http.host}" port="${http.port}" />
    </http:listener-config>

    <!-- ===== APIkit Router Config ===== -->
    <!-- References the local RAML spec. Update to Exchange resource URI after publishing. -->
    <apikit:config
        name="platform-lifecycle-orchestrator-config"
        api="resource::2e14f8c6-4d60-481b-bfb6-798695efc8f4:platform-lifecycle-orchestrator-api:1.0.2:raml:zip:platform-lifecycle-orchestrator.raml"
        outboundHeadersMapName="outboundHeaders"
        httpStatusVarName="httpStatus"
        doc:name="APIkit Config"
        doc:id="a1b2c3d4-0001-0001-0001-000000000004" />

    <!-- ===== MCP Server Config ===== -->
    <!--
        Exposes this Mule app as an MCP server reachable by AI agents (Claude, Copilot, etc.).
        Transport: Streamable HTTP.

        LISTENER / PORT (CloudHub 2.0 reality): the MCP server MUST share apiHttpListenerConfig.
        CH2.0 exposes only the single reserved ${http.port} (8081) through its ingress — a second
        HTTP listener on another port is NOT reachable externally, and two listener-configs cannot
        bind the same port. So REST and MCP necessarily share one listener and are separated by PATH:
          REST : /api/${api.majorVersion}/*
          MCP  : ${mcp.endpointPath}   (default /mcp — kept explicit so ops can target it)

        TRUST-BOUNDARY ISOLATION is therefore a DEPLOY-TIME concern, not app code:
          • API Manager policies bind to the REST flow (autodiscovery) — they do NOT cover /mcp.
          • Govern /mcp via Omni Gateway MCP policies, and/or mark the /mcp Ingress endpoint
            "Internal" (private-space only) in Runtime Manager so only the gateway can reach it.
        serverName and serverVersion are reported to MCP clients during capability negotiation.
    -->
    <mcp:server-config
        name="MCP_Config"
        doc:name="MCP Server Config"
        doc:id="a1b2c3d4-0001-0001-0001-000000000007"
        serverName="${mcp.serverName}"
        serverVersion="${mcp.serverVersion}">
        <mcp:streamable-http-server-connection
            doc:name="MCP Streamable HTTP Connection"
            listenerConfig="apiHttpListenerConfig"
            mcpEndpointPath="${mcp.endpointPath}" />
    </mcp:server-config>

    <!-- ===== API Autodiscovery ===== -->
    <!-- Registers this application with Anypoint API Manager for policy enforcement.
         LOCAL-RUN NOTE: apiId must be a NUMERIC API Manager id. Disabled below for
         local testing (no API Manager). Re-enable and set a real numeric api.id
         (+ -Danypoint.platform.client_id/-client_secret) before deploying to CloudHub. -->
   <!--
    <api-gateway:autodiscovery
        apiId="${api.id}"
        ignoreBasePath="true"
        doc:name="API Autodiscovery"
        doc:id="a1b2c3d4-0001-0001-0001-000000000005"
        flowRef="platform-lifecycle-orchestrator-main" />
    -->

    <!-- ===== Outbound HTTP Request Configs ===== -->

    <!--
        GitHub_Request: HTTPS client for all GitHub REST API calls (api.github.com).
        Default headers sent on every request:
          Authorization  — Bearer token from the secure property store (secure::github.token)
          Accept         — GitHub v3 JSON media type
          User-Agent     — required by GitHub; identifies this service
        Override any header per-request via http:headers on http:request if needed.
    -->
    <http:request-config
        name="GitHub_Request"
        doc:name="GitHub API Request Config"
        doc:id="a1b2c3d4-0001-0001-0001-000000000008"
        basePath="/">
        <http:request-connection host="api.github.com" port="443" protocol="HTTPS" />
        <http:default-headers>
            <http:default-header key="Authorization" value="#['Bearer ' ++ p('secure::github.token')]" />
            <http:default-header key="Accept"        value="application/vnd.github+json" />
            <http:default-header key="User-Agent"    value="platform-lifecycle-orchestrator" />
        </http:default-headers>
    </http:request-config>

    <!--
        Anypoint_Request: HTTPS client for Anypoint Platform REST APIs (ARM, API Manager, etc.).
        Base host: anypoint.mulesoft.com port 443 HTTPS.
        Authentication headers (e.g. Authorization: Bearer <access-token>) are added
        per-request in the calling sub-flow after the token has been obtained.
    -->
    <http:request-config
        name="Anypoint_Request"
        doc:name="Anypoint Platform Request Config"
        doc:id="a1b2c3d4-0001-0001-0001-000000000009"
        basePath="/">
        <http:request-connection host="anypoint.mulesoft.com" port="443" protocol="HTTPS" />
    </http:request-config>

    <!--
        Exchange_Request: HTTPS client for the Anypoint Exchange Maven facade
        (maven.anypoint.mulesoft.com). Used at runtime by pf-load-matrix to fetch the
        centrally-governed compatibility-matrix asset so instances pick up matrix changes
        without a redeploy.
        Auth: HTTP Basic in the Exchange Connected-App facade format —
              username = ~~~Client~~~ , password = <clientId>~?~<clientSecret>
        Credentials come from the encrypted secure property store (secure::anypoint.*).
        The Connected App needs the Exchange Viewer scope.
    -->
    <http:request-config
        name="Exchange_Request"
        doc:name="Exchange Maven Facade Request Config"
        doc:id="a1b2c3d4-0001-0001-0001-000000000013"
        basePath="/">
        <!-- Native HTTP Basic auth (preemptive). The connector base64-encodes
             "<username>:<password>" for us, so no DataWeave toBase64 is needed.
             Exchange facade format: username=~~~Client~~~ , password=<clientId>~?~<clientSecret> -->
        <http:request-connection host="maven.anypoint.mulesoft.com" port="443" protocol="HTTPS">
            <http:authentication>
                <http:basic-authentication username="~~~Client~~~"
                                           password="#[p('secure::anypoint.clientId') ++ '~?~' ++ p('secure::anypoint.clientSecret')]" />
            </http:authentication>
        </http:request-connection>
    </http:request-config>

    <!--
        Slack_Request: HTTPS client for Slack incoming webhook calls (hooks.slack.com).
        The webhook secret is embedded in the path at call time — no Authorization header needed.
        Default header: Content-Type = application/json (required by Slack webhooks).
    -->
    <http:request-config
        name="Slack_Request"
        doc:name="Slack Webhook Request Config"
        doc:id="a1b2c3d4-0001-0001-0001-000000000010"
        basePath="/">
        <http:request-connection host="hooks.slack.com" port="443" protocol="HTTPS" />
        <http:default-headers>
            <http:default-header key="Content-Type" value="application/json" />
        </http:default-headers>
    </http:request-config>

    <!--
        Jira_Request: HTTPS client for the Jira Cloud REST API.
        Base host driven by ${jira.host} so it works for any Jira Cloud tenant without code change.
        Authorization uses HTTP Basic with email + API token from the secure properties store.
        Default headers: Authorization (Basic), Accept and Content-Type (both application/json).
    -->
    <http:request-config
        name="Jira_Request"
        doc:name="Jira Cloud Request Config"
        doc:id="a1b2c3d4-0001-0001-0001-000000000011"
        basePath="/">
        <!-- Native HTTP Basic auth (preemptive): connector base64-encodes
             "<email>:<apiToken>", so no DataWeave toBase64 is needed. -->
        <http:request-connection host="${jira.host}" port="443" protocol="HTTPS">
            <http:authentication>
                <http:basic-authentication username="#[p('secure::jira.email')]"
                                           password="#[p('secure::jira.apiToken')]" />
            </http:authentication>
        </http:request-connection>
        <http:default-headers>
            <http:default-header key="Accept"        value="application/json" />
            <http:default-header key="Content-Type"  value="application/json" />
        </http:default-headers>
    </http:request-config>

</mule>
