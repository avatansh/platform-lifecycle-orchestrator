<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:sap="http://www.mulesoft.org/schema/mule/sap"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/sap http://www.mulesoft.org/schema/mule/sap/current/mule-sap.xsd">

    <!--
        Main entry-point flow for the Platform Lifecycle Orchestrator API.
        Listens on /api/v1/* and routes all requests through the APIkit router.

        Correlation ids (correlationId + processorPath, plus jobId/appName/externalTranId
        stamped via pf-mdc-stamp) are emitted by Log4j2 on EVERY line through the MDC
        (%X{...} in log4j2.xml), so logger messages carry only the semantic detail —
        they no longer repeat flow/correlationId/jobId/app by hand.
    -->
    <flow name="platform-lifecycle-orchestrator-main" doc:id="d4e5f6a7-0004-0004-0004-000000000001">

        <http:listener
            config-ref="apiHttpListenerConfig"
            path="/api/${api.majorVersion}/*"
            doc:name="HTTP Listener"
            doc:id="d4e5f6a7-0004-0004-0004-000000000002">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>

        <!-- Capture flow name for use in log and error messages -->
        <ee:transform doc:name="PV SET vars" doc:id="9ea17760-bb72-438f-834a-b4310f33bd60" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="flowName" ><![CDATA[flow.name]]></ee:set-variable>
				<ee:set-variable variableName="externalTranId" ><![CDATA[attributes.headers['x-correlation-id'] default correlationId]]></ee:set-variable>
				<!-- rawBody MUST be the EXACT inbound bytes: GitHub (/webhook) and the CD job
				     (/webhook/cd-result) sign the raw request body, so the HMAC only matches if we
				     hash those same bytes. Use the raw metadata selector "payload.^raw", which
				     returns the original underlying binary of the body WITHOUT parsing it (it works
				     even though the body is typed application/json). Do NOT use "payload as Binary"
				     or an "output application/octet-stream" identity of payload: for a JSON body
				     DataWeave parses the stream to an Object first and then fails with "Cannot coerce
				     Object to Binary". And do NOT use write(payload,'application/json'), which
				     re-serializes and pretty-prints, yielding different bytes so the signature never
				     matches. The null guard handles bodyless routes (e.g. GET /jobs/{id}); repeatable
				     streaming lets APIkit still parse the body afterwards. -->
				<ee:set-variable variableName="rawBody" ><![CDATA[if (payload == null) ("" as Binary) else (payload.^raw as Binary)]]></ee:set-variable>
				<ee:set-variable variableName="ghSignature" ><![CDATA[attributes.headers['x-hub-signature-256'] default '']]></ee:set-variable>
				<ee:set-variable variableName="ghDelivery" ><![CDATA[attributes.headers['x-github-delivery'] default '']]></ee:set-variable>
				<ee:set-variable variableName="ghEvent" ><![CDATA[attributes.headers['x-github-event'] default '']]></ee:set-variable>
			</ee:variables>
		</ee:transform>

        <!-- Stamp the logging MDC (externalTranId here; jobId/appName refined downstream)
             so every log line for this request carries the correlation ids automatically. -->
		<flow-ref name="pf-mdc-stamp" doc:name="pf-mdc-stamp" doc:id="d4e5f6a7-0004-0004-0004-00000000000a" />

        <logger
            level="INFO"
            doc:name="LOG INFO Request Received"
            doc:id="d4e5f6a7-0004-0004-0004-000000000005"
            message="#[output application/java --- 'REQUEST RECEIVED | method=' ++ attributes.method ++ ' | path=' ++ attributes.requestPath]" />

        <!--
            Capture raw body bytes and GitHub webhook headers BEFORE the APIkit router
            parses the payload. These are cheap set-variable steps that are harmless for
            non-webhook routes; repeatable streams ensure APIkit can still read the body.
        -->

        <logger level="DEBUG" doc:name="LOG DEBUG Request" doc:id="1572d9be-9d0e-400b-a0bd-1d57990f2264" message="#[output application/java --- 'REQUEST | Payload: ' ++ write(payload, &quot;application/json&quot;, {&quot;indent&quot;: false})]"/>
		<apikit:router
            config-ref="platform-lifecycle-orchestrator-config"
            doc:name="APIkit Router"
            doc:id="d4e5f6a7-0004-0004-0004-000000000006" />

        <logger level="DEBUG" doc:name="LOG DEBUG Response" doc:id="6cc02ebe-739b-4947-aa6c-00b6a480cce6" message="#[output application/java --- 'RESPONSE | Payload: ' ++ write(payload, &quot;application/json&quot;, {&quot;indent&quot;: false})]"/>
		<logger
            level="INFO"
            doc:name="LOG INFO Response Sent"
            doc:id="d4e5f6a7-0004-0004-0004-000000000007"
            message="#[output application/java --- 'RESPONSE SENT | status=' ++ (vars.httpStatus default 200)]" />
		<error-handler ref="global-error-handler" doc:name="Global Error Handler" doc:id="d4e5f6a7-0004-0004-0004-000000000008" />

    </flow>

    <!-- ===== APIkit-generated router flows ===== -->
    <!-- Each flow name follows the convention: {method}:\{path}:{config-name} -->

    <!-- POST /jobs/assess -->
    <flow name="post:\jobs\assess:application\json:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000009">
        <flow-ref name="mf-impl-post-jobs-assess"
                  doc:name="mf-impl-post-jobs-assess"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000010" />
    </flow>

    <!-- POST /jobs -->
    <flow name="post:\jobs:application\json:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000011">
        <flow-ref name="mf-impl-post-jobs"
                  doc:name="mf-impl-post-jobs"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000012" />
    </flow>

    <!-- GET /jobs/{jobId} -->
    <flow name="get:\jobs\(jobId):platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000013">
        <flow-ref name="mf-impl-get-job-status"
                  doc:name="mf-impl-get-job-status"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000014" />
    </flow>

    <!-- DELETE /jobs/{jobId} (admin/maintenance) -->
    <flow name="delete:\jobs\(jobId):platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000019">
        <flow-ref name="mf-impl-delete-job"
                  doc:name="mf-impl-delete-job"
                  doc:id="d4e5f6a7-0004-0004-0004-00000000001a" />
    </flow>

    <!-- POST /jobs/{jobId}/reapply (no request body declared in RAML) -->
    <flow name="post:\jobs\(jobId)\reapply:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-00000000001d">
        <flow-ref name="mf-impl-reapply-job"
                  doc:name="mf-impl-reapply-job"
                  doc:id="d4e5f6a7-0004-0004-0004-00000000001e" />
    </flow>

    <!-- POST /parent-pom/upgrade -->
    <flow name="post:\parent-pom\upgrade:application\json:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000021">
        <flow-ref name="mf-impl-post-parent-pom-upgrade"
                  doc:name="mf-impl-post-parent-pom-upgrade"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000022" />
    </flow>

    <!-- POST /webhook -->
    <flow name="post:\webhook:application\json:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000015">
        <flow-ref name="mf-impl-post-webhook"
                  doc:name="mf-impl-post-webhook"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000016" />
    </flow>

    <!-- POST /webhook/cd-result -->
    <flow name="post:\webhook\cd-result:application\json:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000017">
        <flow-ref name="mf-impl-post-cd-result"
                  doc:name="mf-impl-post-cd-result"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000018" />
    </flow>

</mule>
