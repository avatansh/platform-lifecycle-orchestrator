<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd">

    <!--
        Main entry-point flow for the Platform Lifecycle Orchestrator API.
        Listens on /api/v1/* and routes all requests through the APIkit router.
        Structured log lines use the pattern:
          LOG {scope} | flow={flowName} | correlationId={correlationId} | {detail}
    -->
    <flow name="platform-lifecycle-orchestrator-main" doc:id="d4e5f6a7-0004-0004-0004-000000000001">

        <http:listener
            config-ref="apiHttpListenerConfig"
            path="/api/${api.majorVersion}/*"
            doc:name="HTTP Listener"
            doc:id="d4e5f6a7-0004-0004-0004-000000000002">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>

        <!-- Capture flow name for use in log and error messages -->
        <set-variable
            variableName="flowName"
            value="#[flow.name]"
            doc:name="PV SET flowName"
            doc:id="d4e5f6a7-0004-0004-0004-000000000003" />

        <!-- Capture inbound X-Correlation-Id header for distributed tracing -->
        <set-variable
            variableName="externalTranId"
            value="#[attributes.headers['x-correlation-id'] default correlationId]"
            doc:name="PV SET externalTranId"
            doc:id="d4e5f6a7-0004-0004-0004-000000000004" />

        <logger
            level="INFO"
            doc:name="LOG INFO Request Received"
            doc:id="d4e5f6a7-0004-0004-0004-000000000005"
            message="#['LOG INFO REQUEST RECEIVED | flow=' ++ vars.flowName ++ ' | correlationId=' ++ correlationId ++ ' | externalTranId=' ++ vars.externalTranId ++ ' | method=' ++ attributes.method ++ ' | path=' ++ attributes.requestPath]" />

        <!--
            Capture raw body bytes and GitHub webhook headers BEFORE the APIkit router
            parses the payload. These are cheap set-variable steps that are harmless for
            non-webhook routes; repeatable streams ensure APIkit can still read the body.
        -->
        <set-variable variableName="rawBody"
                      value="#[write(payload, 'application/json') as Binary]"
                      doc:name="PV SET rawBody"
                      doc:id="d4e5f6a7-0004-0004-0004-000000000020"
                      doc:description="Raw request bytes used for GitHub HMAC signature verification. Uses write() because this runtime presents the JSON body as a parsed Object, which 'payload as Binary' cannot coerce directly." />

        <set-variable variableName="ghSignature"
                      value="#[attributes.headers['x-hub-signature-256'] default '']"
                      doc:name="PV SET ghSignature"
                      doc:id="d4e5f6a7-0004-0004-0004-000000000021"
                      doc:description="GitHub HMAC-SHA256 signature header sent with every webhook delivery" />

        <set-variable variableName="ghDelivery"
                      value="#[attributes.headers['x-github-delivery'] default '']"
                      doc:name="PV SET ghDelivery"
                      doc:id="d4e5f6a7-0004-0004-0004-000000000022"
                      doc:description="GitHub unique delivery UUID — used as idempotency key" />

        <set-variable variableName="ghEvent"
                      value="#[attributes.headers['x-github-event'] default '']"
                      doc:name="PV SET ghEvent"
                      doc:id="d4e5f6a7-0004-0004-0004-000000000023"
                      doc:description="GitHub event type (e.g. pull_request, push, ping)" />

        <apikit:router
            config-ref="platform-lifecycle-orchestrator-config"
            doc:name="APIkit Router"
            doc:id="d4e5f6a7-0004-0004-0004-000000000006" />

        <logger
            level="INFO"
            doc:name="LOG INFO Response Sent"
            doc:id="d4e5f6a7-0004-0004-0004-000000000007"
            message="#['LOG INFO RESPONSE SENT | flow=' ++ vars.flowName ++ ' | correlationId=' ++ correlationId ++ ' | status=' ++ (vars.httpStatus default 200 as String)]" />

        <error-handler ref="global-error-handler" doc:name="Global Error Handler" doc:id="d4e5f6a7-0004-0004-0004-000000000008" />

    </flow>

    <!-- ===== APIkit-generated router flows ===== -->
    <!-- Each flow name follows the convention: {method}:\{path}:{config-name} -->

    <!-- POST /jobs/assess -->
    <flow name="post:\jobs\assess:application\json:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000009">
        <flow-ref name="mf-impl-post-jobs-assess"
                  doc:name="mf-impl-post-jobs-assess"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000010" />
    </flow>

    <!-- POST /jobs -->
    <flow name="post:\jobs:application\json:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000011">
        <flow-ref name="mf-impl-post-jobs"
                  doc:name="mf-impl-post-jobs"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000012" />
    </flow>

    <!-- GET /jobs/{jobId} -->
    <flow name="get:\jobs\(jobId):platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000013">
        <flow-ref name="mf-impl-get-job-status"
                  doc:name="mf-impl-get-job-status"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000014" />
    </flow>

    <!-- POST /webhook -->
    <flow name="post:\webhook:application\json:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000015">
        <flow-ref name="mf-impl-post-webhook"
                  doc:name="mf-impl-post-webhook"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000016" />
    </flow>

    <!-- POST /webhook/cd-result -->
    <flow name="post:\webhook\cd-result:application\json:platform-lifecycle-orchestrator-config"
          doc:id="d4e5f6a7-0004-0004-0004-000000000017">
        <flow-ref name="mf-impl-post-cd-result"
                  doc:name="mf-impl-post-cd-result"
                  doc:id="d4e5f6a7-0004-0004-0004-000000000018" />
    </flow>

</mule>
