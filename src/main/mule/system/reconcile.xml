<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <flow name="pf-reconcile"
          doc:id="pfrc0001-0001-0001-0001-000000000001"
          doc:name="pf-reconcile"
          doc:description="Scheduled sweep: reconciles stale PR_OPEN and DEPLOYING jobs. Runs every reconcile.frequencyMillis.">

        <scheduler doc:name="Reconcile Scheduler" doc:id="pfrc0001-0001-0001-0001-000000000002">
            <scheduling-strategy>
                <fixed-frequency frequency="${reconcile.frequencyMillis}" />
            </scheduling-strategy>
        </scheduler>

        <logger level="INFO" doc:name="LOG INFO sweep start" doc:id="pfrc0001-0001-0001-0001-000000000003"
                message="#[output application/java --- 'LOG INFO | flow=pf-reconcile | correlationId=' ++ correlationId ++ ' | reconcile sweep starting']" />

        <os:retrieve-all-keys objectStore="jobStore"
                              doc:name="OS Retrieve All Keys" doc:id="pfrc0001-0001-0001-0001-000000000004" />

        <ee:transform doc:name="PV SET jobKeys and INIT fixed" doc:id="d7f70474-11f5-4bfa-84ad-d90b6dc3377f" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="jobKeys" ><![CDATA[(payload default []) filter ($ startsWith 'job-')]]></ee:set-variable>
				<ee:set-variable variableName="fixed" ><![CDATA[0]]></ee:set-variable>
			</ee:variables>
		</ee:transform>

        <foreach collection="#[vars.jobKeys]" doc:name="FOR EACH job key" doc:id="pfrc0001-0001-0001-0001-000000000007">

            <try doc:name="TRY per-job (error isolation)" doc:id="pfrc0001-0001-0001-0001-000000000008">

                <set-variable variableName="k" value="#[payload]" doc:name="PV SET k" doc:id="pfrc0001-0001-0001-0001-000000000009" />

                <os:retrieve key="#[vars.k]" objectStore="jobStore"
                             target="rec" doc:name="OS Retrieve job record" doc:id="pfrc0001-0001-0001-0001-000000000010">
                    <os:default-value>#[{}]</os:default-value>
                </os:retrieve>

                <set-variable variableName="isStale" doc:name="PV SET isStale" doc:id="pfrc0001-0001-0001-0001-000000000011"
                              value="#[output application/java --- (vars.rec.updatedAt != null) and (((now() as Number) - (vars.rec.updatedAt as DateTime as Number)) > (p('reconcile.staleSeconds') as Number))]" />

                <choice doc:name="CHOICE reconcile action?" doc:id="pfrc0001-0001-0001-0001-000000000012">

                    <when expression="#[output application/java --- vars.isStale and vars.rec.status == 'PR_OPEN' and vars.rec.prNumber != null]"
                          doc:name="PR_OPEN stale" doc:id="pfrc0001-0001-0001-0001-000000000013">

                        <http:request method="GET" config-ref="GitHub_Request"
                                      path="#['/repos/' ++ vars.rec.coords.owner ++ '/' ++ vars.rec.coords.repo ++ '/pulls/' ++ vars.rec.prNumber]"
                                      target="pr" doc:name="GET PR state" doc:id="pfrc0001-0001-0001-0001-000000000014" />

                        <choice doc:name="CHOICE PR outcome?" doc:id="pfrc0001-0001-0001-0001-000000000015">

                            <when expression="#[vars.pr.merged == true]" doc:name="PR merged" doc:id="pfrc0001-0001-0001-0001-000000000016">
                                <os:retrieve key="#[vars.k]" objectStore="jobStore"
                                             doc:name="OS Re-retrieve before DEPLOYING" doc:id="pfrc0001-0001-0001-0001-000000000017">
                                    <os:default-value>#[{}]</os:default-value>
                                </os:retrieve>
                                <ee:transform doc:name="DW DEPLOYING" doc:id="pfrc0001-0001-0001-0001-000000000018">
                                    <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
import mergeWith from dw::core::Objects
import nowUtc from dwl::dates
--- payload mergeWith { status: "DEPLOYING", updatedAt: nowUtc() }]]></ee:set-payload></ee:message>
                                </ee:transform>
                                <os:store key="#[vars.k]" objectStore="jobStore"
                                          doc:name="OS Store DEPLOYING" doc:id="pfrc0001-0001-0001-0001-000000000019">
                                    <os:value>#[payload]</os:value>
                                </os:store>
                                <set-variable variableName="fixed" value="#[vars.fixed + 1]"
                                              doc:name="PV fixed++" doc:id="pfrc0001-0001-0001-0001-000000000020" />
                                <logger level="INFO" doc:name="LOG INFO PR_OPENâ†’DEPLOYING" doc:id="pfrc0001-0001-0001-0001-000000000021"
                                        message="#[output application/java --- 'LOG INFO | flow=pf-reconcile | reconciled PR_OPENâ†’DEPLOYING (missed merge webhook) | jobId=' ++ vars.k]" />
                            </when>

                            <when expression="#[vars.pr.state == 'closed' and vars.pr.merged == false]"
                                  doc:name="PR closed unmerged" doc:id="pfrc0001-0001-0001-0001-000000000022">
                                <os:retrieve key="#[vars.k]" objectStore="jobStore"
                                             doc:name="OS Re-retrieve before FAILED_DEPLOY" doc:id="pfrc0001-0001-0001-0001-000000000023">
                                    <os:default-value>#[{}]</os:default-value>
                                </os:retrieve>
                                <ee:transform doc:name="DW FAILED_DEPLOY closed-unmerged" doc:id="pfrc0001-0001-0001-0001-000000000024">
                                    <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
import mergeWith from dw::core::Objects
import nowUtc from dwl::dates
--- payload mergeWith { status: "FAILED_DEPLOY", error: "PR was closed without merging",
    completedAt: nowUtc(),
    updatedAt: nowUtc() }]]></ee:set-payload></ee:message>
                                </ee:transform>
                                <os:store key="#[vars.k]" objectStore="jobStore"
                                          doc:name="OS Store FAILED_DEPLOY" doc:id="pfrc0001-0001-0001-0001-000000000025">
                                    <os:value>#[payload]</os:value>
                                </os:store>
                                <set-variable variableName="lockApp" value="#[vars.rec.appName default '']"
                                              doc:name="PV lockApp" doc:id="pfrc0001-0001-0001-0001-000000000026" />
                                <flow-ref name="pf-release-lock" doc:name="pf-release-lock" doc:id="pfrc0001-0001-0001-0001-000000000027" />
                                <set-variable variableName="fixed" value="#[vars.fixed + 1]"
                                              doc:name="PV fixed++" doc:id="pfrc0001-0001-0001-0001-000000000030" />
                                <logger level="INFO" doc:name="LOG INFO PR_OPENâ†’FAILED_DEPLOY" doc:id="pfrc0001-0001-0001-0001-000000000031"
                                        message="#[output application/java --- 'LOG INFO | flow=pf-reconcile | reconciled PR_OPENâ†’FAILED_DEPLOY (closed unmerged) | jobId=' ++ vars.k]" />
                            </when>

                            <otherwise doc:name="PR still open" doc:id="pfrc0001-0001-0001-0001-000000000032">
                                <logger level="DEBUG" doc:name="LOG DEBUG PR still open" doc:id="pfrc0001-0001-0001-0001-000000000033"
                                        message="#[output application/java --- 'LOG DEBUG | flow=pf-reconcile | PR still open, leaving as-is | jobId=' ++ vars.k]" />
                            </otherwise>

                        </choice>

                    </when>

                    <when expression="#[output application/java --- vars.isStale and vars.rec.status == 'DEPLOYING']"
                          doc:name="DEPLOYING stale" doc:id="pfrc0001-0001-0001-0001-000000000034">

                        <!-- Missed cd-result callback (timeout). Per ADR-015, make ONE Application
                             Manager call to determine the real outcome instead of polling. -->
                        <choice doc:name="CHOICE verify enabled?" doc:id="pfrc0001-0001-0001-0001-000000000041">
                            <when expression="#[(p('anypoint.verify.enabled') default 'true') == 'true']"
                                  doc:name="verify enabled" doc:id="pfrc0001-0001-0001-0001-000000000042">
                                <ee:transform doc:name="PV SET vfy - app, env, orgId" doc:id="fcf7357f-b3b1-4e43-8cf7-fdfbbf93f25d">
									<ee:message>
									</ee:message>
									<ee:variables >
										<ee:set-variable variableName="vfyApp" ><![CDATA[vars.rec.appName]]></ee:set-variable>
										<ee:set-variable variableName="vfyEnv" ><![CDATA[vars.rec.environment default '']]></ee:set-variable>
										<ee:set-variable variableName="vfyOrgId" ><![CDATA[vars.rec.coords.orgId default p('anypoint.defaultOrgId')]]></ee:set-variable>
									</ee:variables>
								</ee:transform>
								<flow-ref name="pf-verify-deployment" doc:name="pf-verify-deployment"
                                          doc:id="pfrc0001-0001-0001-0001-000000000046" />

                                <choice doc:name="CHOICE platform verdict?" doc:id="pfrc0001-0001-0001-0001-000000000047">

                                    <when expression="#[(vars.verify.verified default false) and (vars.verify.healthy default false)]"
                                          doc:name="platform healthy â†’ DEPLOYED" doc:id="pfrc0001-0001-0001-0001-000000000048">
                                        <os:retrieve key="#[vars.k]" objectStore="jobStore"
                                                     doc:name="OS Re-retrieve before DEPLOYED" doc:id="pfrc0001-0001-0001-0001-000000000049">
                                            <os:default-value>#[{}]</os:default-value>
                                        </os:retrieve>
                                        <ee:transform doc:name="DW DEPLOYED (reconciled)" doc:id="pfrc0001-0001-0001-0001-000000000050">
                                            <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
import mergeWith from dw::core::Objects
import nowUtc from dwl::dates
--- payload mergeWith { status: "DEPLOYED", platformVerified: true, platformStatus: (vars.verify.status default null),
    platformRuntimeVersion: (vars.verify.runtimeVersion default null),
    completedAt: nowUtc(),
    updatedAt: nowUtc() }]]></ee:set-payload></ee:message>
                                        </ee:transform>
                                        <os:store key="#[vars.k]" objectStore="jobStore"
                                                  doc:name="OS Store DEPLOYED" doc:id="pfrc0001-0001-0001-0001-000000000051">
                                            <os:value>#[payload]</os:value>
                                        </os:store>
                                        <set-variable variableName="lockApp" value="#[vars.rec.appName default '']"
                                                      doc:name="PV lockApp" doc:id="pfrc0001-0001-0001-0001-000000000052" />
                                        <flow-ref name="pf-release-lock" doc:name="pf-release-lock" doc:id="pfrc0001-0001-0001-0001-000000000053" />
                                        <set-variable variableName="fixed" value="#[vars.fixed + 1]"
                                                      doc:name="PV fixed++" doc:id="pfrc0001-0001-0001-0001-000000000056" />
                                        <logger level="INFO" doc:name="LOG INFO DEPLOYINGâ†’DEPLOYED" doc:id="pfrc0001-0001-0001-0001-000000000057"
                                                message="#[output application/java --- 'LOG INFO | flow=pf-reconcile | reconciled DEPLOYINGâ†’DEPLOYED (missed cd-result, platform confirmed) | jobId=' ++ vars.k ++ ' | platformStatus=' ++ (vars.verify.status default '?')]" />
                                    </when>

                                    <when expression="#[(vars.verify.verified default false) and not (vars.verify.healthy default false)]"
                                          doc:name="platform unhealthy â†’ FAILED_DEPLOY" doc:id="pfrc0001-0001-0001-0001-000000000058">
										<os:retrieve key="#[vars.k]" objectStore="jobStore" doc:name="OS Re-retrieve before FAILED_DEPLOY" doc:id="pfrc0001-0001-0001-0001-000000000059">
                                            <os:default-value>#[{}]</os:default-value>
                                        </os:retrieve>
										<ee:transform doc:name="DW FAILED_DEPLOY (reconciled)" doc:id="pfrc0001-0001-0001-0001-000000000060">
                                            <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
import mergeWith from dw::core::Objects
import nowUtc from dwl::dates
--- payload mergeWith { status: "FAILED_DEPLOY",
    error: "cd-result timed out; platform status=" ++ (vars.verify.status default "UNKNOWN"),
    platformVerified: true, platformStatus: (vars.verify.status default null),
    completedAt: nowUtc(),
    updatedAt: nowUtc() }]]></ee:set-payload></ee:message>
                                        </ee:transform>
										<os:store key="#[vars.k]" objectStore="jobStore"
                                                  doc:name="OS Store FAILED_DEPLOY" doc:id="pfrc0001-0001-0001-0001-000000000061">
                                            <os:value>#[payload]</os:value>
                                        </os:store>
                                        <set-variable variableName="lockApp" value="#[vars.rec.appName default '']"
                                                      doc:name="PV lockApp" doc:id="pfrc0001-0001-0001-0001-000000000062" />
                                        <flow-ref name="pf-release-lock" doc:name="pf-release-lock" doc:id="pfrc0001-0001-0001-0001-000000000063" />
                                        <set-variable variableName="fixed" value="#[vars.fixed + 1]"
                                                      doc:name="PV fixed++" doc:id="pfrc0001-0001-0001-0001-000000000066" />
                                        <logger level="WARN" doc:name="LOG WARN DEPLOYINGâ†’FAILED_DEPLOY" doc:id="pfrc0001-0001-0001-0001-000000000067"
                                                message="#[output application/java --- 'LOG WARN | flow=pf-reconcile | reconciled DEPLOYINGâ†’FAILED_DEPLOY (missed cd-result, platform unhealthy) | jobId=' ++ vars.k ++ ' | platformStatus=' ++ (vars.verify.status default '?')]" />
                                    </when>

                                    <otherwise doc:name="platform unverified â†’ leave" doc:id="pfrc0001-0001-0001-0001-000000000068">
                                        <logger level="DEBUG" doc:name="LOG DEBUG platform unreachable" doc:id="pfrc0001-0001-0001-0001-000000000069"
                                                message="#[output application/java --- 'LOG DEBUG | flow=pf-reconcile | DEPLOYING stale but platform unverified, retry next sweep | jobId=' ++ vars.k]" />
                                    </otherwise>

                                </choice>

                            </when>
                            <otherwise doc:name="verify disabled â†’ leave" doc:id="pfrc0001-0001-0001-0001-000000000070">
                                <logger level="DEBUG" doc:name="LOG DEBUG DEPLOYING awaiting cd-result" doc:id="pfrc0001-0001-0001-0001-000000000035"
                                        message="#[output application/java --- 'LOG DEBUG | flow=pf-reconcile | still DEPLOYING beyond threshold, verify disabled, awaiting cd-result | jobId=' ++ vars.k]" />
                            </otherwise>
                        </choice>

                    </when>

                    <!-- â”€â”€ Crash recovery: stale EARLY-STAGE orphans â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
                         A job left in a non-terminal early stage (PROCESSING/ASSESSING/COMMITTING/
                         COMMITTED) that has not advanced within staleSeconds was almost certainly
                         orphaned by a runtime restart/crash mid-pipeline (the upgrade runs in an
                         in-memory async scope that does NOT survive a restart). These stages have
                         no external state to reconcile against, so we finalize the job as
                         FAILED_INTERRUPTED and release its single-flight lock â€” otherwise the app
                         would stay un-upgradeable until the 1-day lock TTL expires. Re-submitting
                         starts a fresh job. (A COMMITTED orphan may leave an unused upgrade branch
                         on GitHub; that is harmless and can be cleaned up or reused on retry.) -->
                    <when expression="#[output application/java --- vars.isStale and (['PROCESSING','ASSESSING','COMMITTING','COMMITTED'] contains (vars.rec.status default ''))]"
                          doc:name="early-stage orphan" doc:id="pfrc0001-0001-0001-0001-000000000100">
                        <os:retrieve key="#[vars.k]" objectStore="jobStore"
                                     doc:name="OS Re-retrieve before FAILED_INTERRUPTED" doc:id="pfrc0001-0001-0001-0001-000000000101">
                            <os:default-value>#[{}]</os:default-value>
                        </os:retrieve>
                        <ee:transform doc:name="DW FAILED_INTERRUPTED" doc:id="pfrc0001-0001-0001-0001-000000000102">
                            <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
import mergeWith from dw::core::Objects
import nowUtc from dwl::dates
--- payload mergeWith { status: "FAILED_INTERRUPTED",
    error: "Upgrade was interrupted before completion (likely a runtime restart or crash) and did not advance within the stale threshold. Automatically failed by the reconciler; re-submit to retry.",
    completedAt: nowUtc(),
    updatedAt: nowUtc() }]]></ee:set-payload></ee:message>
                        </ee:transform>
                        <os:store key="#[vars.k]" objectStore="jobStore"
                                  doc:name="OS Store FAILED_INTERRUPTED" doc:id="pfrc0001-0001-0001-0001-000000000103">
                            <os:value>#[payload]</os:value>
                        </os:store>
                        <set-variable variableName="lockApp" value="#[vars.rec.appName default '']"
                                      doc:name="PV lockApp" doc:id="pfrc0001-0001-0001-0001-000000000104" />
                        <flow-ref name="pf-release-lock" doc:name="pf-release-lock" doc:id="pfrc0001-0001-0001-0001-000000000105" />
                        <set-variable variableName="fixed" value="#[vars.fixed + 1]"
                                      doc:name="PV fixed++" doc:id="pfrc0001-0001-0001-0001-000000000108" />
                        <logger level="WARN" doc:name="LOG WARN early-stageâ†’FAILED_INTERRUPTED" doc:id="pfrc0001-0001-0001-0001-000000000109"
                                message="#[output application/java --- 'LOG WARN | flow=pf-reconcile | reconciled ' ++ (vars.rec.status default '?') ++ 'â†’FAILED_INTERRUPTED (orphaned by restart/crash) | jobId=' ++ vars.k ++ ' | app=' ++ (vars.rec.appName default '?') ++ ' | lock released']" />
                    </when>

                    <otherwise doc:name="not stale or non-reconcilable" doc:id="pfrc0001-0001-0001-0001-000000000036">
                        <logger level="DEBUG" doc:name="LOG DEBUG job not reconcilable" doc:id="pfrc0001-0001-0001-0001-000000000037"
                                message="#[output application/java --- 'LOG DEBUG | flow=pf-reconcile | not stale or non-reconcilable | jobId=' ++ vars.k ++ ' | status=' ++ (vars.rec.status default '?') ++ ' | stale=' ++ vars.isStale]" />
                    </otherwise>

                </choice>

                <error-handler>
                    <on-error-continue type="ANY" doc:id="pfrc0001-0001-0001-0001-000000000038">
                        <logger level="WARN" doc:name="LOG WARN per-job reconcile error" doc:id="pfrc0001-0001-0001-0001-000000000039"
                                message="#[output application/java --- 'LOG WARN | flow=pf-reconcile | error reconciling job ' ++ (vars.k default '?') ++ ': ' ++ (error.description default 'unknown')]" />
                    </on-error-continue>
                </error-handler>
            </try>

        </foreach>

        <logger level="INFO" doc:name="LOG INFO sweep done" doc:id="pfrc0001-0001-0001-0001-000000000040"
                message="#[output application/java --- 'LOG INFO | flow=pf-reconcile | correlationId=' ++ correlationId ++ ' | reconcile sweep done | fixed=' ++ vars.fixed ++ ' | scanned=' ++ sizeOf(vars.jobKeys default [])]" />

    </flow>

</mule>
