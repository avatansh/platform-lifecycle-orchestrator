<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ==========================================================================
         Anypoint Platform integration (post-deploy verification) — ADR-015

         Event-driven, single-confirmation model (NO polling):
           - The primary deploy signal comes from the CI/CD webhook (cd-result).
           - We make ONE Application Manager call to confirm the app is healthy.
           - The reconcile sweep makes ONE call as a safety net for missed callbacks.

         Sub-flows:
           - pf-get-anypoint-token : client_credentials bearer, cached in-memory (~55 min).
           - pf-verify-deployment  : resolves envId + reads the app's AMC deployment status.

         Both caching strategies use the default in-memory managed store, so they
         consume NO Object Store v2 TPS/entries.
         ========================================================================== -->

    <!--
        anypointTokenCachingStrategy: time-bucketed key so the bearer token is fetched
        at most once per anypoint.tokenRefreshSeconds window (default 3300s / 55 min,
        below the platform's 60-min token TTL). In-memory only.
    -->
    <ee:object-store-caching-strategy
        name="anypointTokenCachingStrategy"
        doc:name="Anypoint Token Caching Strategy"
        doc:id="pfpt0001-0001-0001-0001-000000000001"
        objectStore="anypointTokenCacheOS"
        keyGenerationExpression="#['anypoint-token-' ++ (floor((now() as Number {unit: 'seconds'}) / (p('anypoint.tokenRefreshSeconds') as Number)) as String)]" />

    <!--
        anypointEnvCachingStrategy: per-org cache for the org→environments lookup.
        Environments rarely change, so cache once per org for the JVM lifetime. In-memory.
    -->
    <ee:object-store-caching-strategy
        name="anypointEnvCachingStrategy"
        doc:name="Anypoint Environments Caching Strategy"
        doc:id="pfpt0002-0002-0002-0002-000000000001"
        keyGenerationExpression="#['anypoint-envs::' ++ (vars.vfyOrgId default '')]" />

    <!-- ==========================================================================
         pf-get-anypoint-token
           Requires: nothing (reads secure::anypoint.clientId / clientSecret)
           Returns:  vars.anypointToken = bearer access token (String)
         The token POST only fires on a cache miss (~ once per 55 min per worker).
         ========================================================================== -->
    <sub-flow name="pf-get-anypoint-token"
              doc:id="pfpt0003-0003-0003-0003-000000000001">

        <logger level="INFO" doc:name="LOG INFO START pf-get-anypoint-token" doc:id="ac642d9e-f5f9-44a9-92c0-a60a610e233c" message="#[output application/java --- 'START - pf-get-anypoint-token']"/>
		<ee:cache cachingStrategy-ref="anypointTokenCachingStrategy"
                  doc:name="CACHE Anypoint bearer token"
                  doc:id="pfpt0003-0003-0003-0003-000000000002"
                  doc:description="Fetch + cache the Connected App client_credentials token; time-bucketed key">

            <ee:transform doc:name="DW Build token request body"
                          doc:id="pfpt0003-0003-0003-0003-000000000003">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    grant_type:    "client_credentials",
    client_id:     p('secure::anypoint.clientId'),
    client_secret: p('secure::anypoint.clientSecret')
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>

            <logger level="DEBUG" doc:name="LOG DEBUG Request" doc:id="27721420-e119-407d-83c2-ab92076c9773" message="#[output application/java --- 'Sending Request to URL:' ++ Mule::p('anypoint.tokenPath') ++ ' Payload: ' ++ write(payload, &quot;application/json&quot;, {&quot;indent&quot;: false})]"/>
			<http:request method="POST"
                          config-ref="Anypoint_Request"
                          path="#[p('anypoint.tokenPath')]"
                          doc:name="POST Anypoint token"
                          doc:id="pfpt0003-0003-0003-0003-000000000004">
                <http:headers><![CDATA[#[{ "Content-Type": "application/json" }]]]></http:headers>
            </http:request>

            <logger level="DEBUG" doc:name="LOG DEBUG Response" doc:id="130aef9d-ea05-4b59-b6c0-f8582e40b21a" message="#[output application/java --- 'Response Received Payload: ' ++ write(payload, 'application/json', {'indent': false})]"/>
			<ee:transform doc:name="DW Extract access_token"
                          doc:id="pfpt0003-0003-0003-0003-000000000005">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output text/plain
---
(payload.access_token default "") as String]]></ee:set-payload>
                </ee:message>
            </ee:transform>

        </ee:cache>

        <set-variable variableName="anypointToken"
                      value="#[payload as String]"
                      doc:name="PV SET vars.anypointToken"
                      doc:id="pfpt0003-0003-0003-0003-000000000006" />
		<logger level="INFO" doc:name="LOG INFO END pf-get-anypoint-token" doc:id="38f5b9c3-b144-4f6d-8023-4595ccfac3d4" message="#[output application/java --- 'END - pf-get-anypoint-token']"/>

    </sub-flow>

    <!-- ==========================================================================
         pf-verify-deployment
           Requires: vars.vfyApp   (application name as it appears in AMC)
                     vars.vfyEnv   (environment name, e.g. "Production")
                     vars.vfyOrgId (business group / org id)
           Returns:  vars.verify = {
                        verified: Boolean,   // true if the platform answered
                        found:    Boolean,   // true if a deployment matched vfyApp
                        status:   String,    // upper-case AMC status ("RUNNING", ...)
                        healthy:  Boolean,   // status ∈ anypoint.verify.healthyStatuses
                        runtimeVersion: String|null
                     }

         Non-fatal: any platform/network error yields verified=false so the caller
         can fall back to the CI signal rather than block the job.

         NOTE: AMC/CH2.0 deployment field paths vary slightly by API version. Status is
         read defensively (application.status → status). Adjust the field paths below
         if the live response schema differs.
         ========================================================================== -->
    <sub-flow name="pf-verify-deployment"
              doc:id="pfpt0004-0004-0004-0004-000000000001">

        <logger level="INFO" doc:name="LOG INFO START pf-verify-deployment" doc:id="1d25e60c-eec2-473b-a5ac-573d5fb72926" message="#[output application/java --- 'START - pf-verify-deployment']" />
		<try doc:name="TRY platform verify (non-fatal)"
             doc:id="pfpt0004-0004-0004-0004-000000000002">

            <flow-ref name="pf-get-anypoint-token"
                      doc:name="pf-get-anypoint-token"
                      doc:id="pfpt0004-0004-0004-0004-000000000003" />

            <!-- Resolve environment name → envId (cached per org) -->
			<logger level="DEBUG" doc:name="LOG DEBUG Request" doc:id="6ac19e5b-24e1-44cc-a9e9-e3ab3734ad0b" message="#[output application/java --- 'Sending Request to URL: /accounts/api/organizations/' ++ (vars.vfyOrgId default '') ++ '/environments' ++ ' Payload: ' ++ write(payload, &quot;application/json&quot;, {&quot;indent&quot;: false})]" />
			<ee:cache cachingStrategy-ref="anypointEnvCachingStrategy"
                      doc:name="CACHE org environments"
                      doc:id="pfpt0004-0004-0004-0004-000000000004">
				<http:request method="GET"
                              config-ref="Anypoint_Request"
                              path="#['/accounts/api/organizations/' ++ (vars.vfyOrgId default '') ++ '/environments']"
                              doc:name="GET org environments"
                              doc:id="pfpt0004-0004-0004-0004-000000000005">
                    <http:headers><![CDATA[#[{ "Authorization": "Bearer " ++ (vars.anypointToken default "") }]]]></http:headers>
                </http:request>
            </ee:cache>
			<logger level="DEBUG" doc:name="LOG DEBUG Response" doc:id="2e6544bf-13df-46ad-86c3-0997c8cd4039" message="#[output application/java --- 'Response Received Payload: ' ++ write(payload, 'application/json', {'indent': false})]" />
			<set-variable variableName="envId"
                          value="#[((payload.data default []) filter ((e) -> upper(e.name default '') == upper(vars.vfyEnv default '')))[0].id default '']"
                          doc:name="PV SET vars.envId"
                          doc:id="pfpt0004-0004-0004-0004-000000000006" />

            <!-- Read the app's deployment(s) for this environment -->
            <http:request method="GET"
                          config-ref="Anypoint_Request"
                          path="#['/amc/application-manager/api/v2/organizations/' ++ (vars.vfyOrgId default '') ++ '/environments/' ++ (vars.envId default '') ++ '/deployments']"
                          target="deployments"
                          doc:name="GET AMC deployments"
                          doc:id="pfpt0004-0004-0004-0004-000000000007">
                <http:headers><![CDATA[#[{ "Authorization": "Bearer " ++ (vars.anypointToken default "") }]]]></http:headers>
            </http:request>

            <ee:transform doc:name="DW Build verify result"
                          doc:id="pfpt0004-0004-0004-0004-000000000008">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
var items  = (vars.deployments.items default vars.deployments.data default [])
var dep    = (items filter ((d) -> (d.name default "") == (vars.vfyApp default "")))[0]
var st     = upper(((dep.application.status default dep.status default "") as String))
var okList = ((p('anypoint.verify.healthyStatuses') default "") splitBy ",") map upper(trim($))
---
{
    verified:       (dep != null),
    found:          (dep != null),
    status:         st,
    healthy:        (dep != null) and (okList contains st),
    runtimeVersion: (dep.target.deploymentSettings.runtimeVersion
                     default dep.currentRuntimeVersion
                     default dep.runtimeVersion
                     default null)
}]]></ee:set-payload>
                </ee:message>
            </ee:transform>

            <set-variable variableName="verify"
                          value="#[payload]"
                          doc:name="PV SET vars.verify"
                          doc:id="pfpt0004-0004-0004-0004-000000000009" />
			<error-handler>
                <on-error-continue type="ANY"
                                   doc:name="platform unreachable → unverified"
                                   doc:id="pfpt0004-0004-0004-0004-000000000010">
                    <logger level="WARN"
                            doc:name="LOG WARN verify failed (non-fatal)"
                            doc:id="pfpt0004-0004-0004-0004-000000000011"
                            message="#[output application/java --- 'platform verify failed (non-fatal), falling back to CI signal | app=' ++ (vars.vfyApp default '?') ++ ' | error=' ++ (error.description default 'unknown')]" />
                    <set-variable variableName="verify"
                                  value="#[{ verified: false, found: false, status: 'UNKNOWN', healthy: false, runtimeVersion: null }]"
                                  doc:name="PV SET vars.verify (unverified)"
                                  doc:id="pfpt0004-0004-0004-0004-000000000012" />
                </on-error-continue>
            </error-handler>

        </try>
		<logger level="INFO" doc:name="LOG INFO END pf-verify-deployment" doc:id="b7f9854a-fac4-4f4e-97eb-476fcfbccb7a" message="#[output application/java --- 'END - pf-verify-deployment']" />

    </sub-flow>

    <!-- ==========================================================================
         pf-read-deployment  (Batch A #1 — assessment cross-check)
           Requires: vars.vfyApp   (application name as it appears in AMC)
                     vars.vfyEnv   (environment name, e.g. "Development")
                     vars.vfyOrgId (business group / org id)
           Returns:  vars.deployedState = {
                        reachable:      Boolean,   // Runtime Manager answered
                        found:          Boolean,   // a deployment matched vfyApp
                        status:         String,    // AMC status (upper-case) or "UNKNOWN"
                        runtimeVersion: String|null
                     }

         Thin normaliser over pf-verify-deployment so the assess flow can compare the
         REAL deployed runtime against the source pom. Fully non-fatal: pf-verify-deployment
         already swallows platform/network errors (yielding verified=false), so this never
         raises and the caller falls back to a source-only assessment.
         ========================================================================== -->
    <sub-flow name="pf-read-deployment"
              doc:id="pfpt0005-0005-0005-0005-000000000001">

        <logger level="INFO" doc:name="LOG INFO START pf-read-deployment" doc:id="pfpt0005-0005-0005-0005-000000000002" message="#[output application/java --- 'START - pf-read-deployment | app=' ++ (vars.vfyApp default '?') ++ ' | env=' ++ (vars.vfyEnv default '?')]" />
        <flow-ref name="pf-verify-deployment"
                  doc:name="pf-verify-deployment"
                  doc:id="pfpt0005-0005-0005-0005-000000000003" />
        <set-variable variableName="deployedState"
                      doc:name="PV SET vars.deployedState"
                      doc:id="pfpt0005-0005-0005-0005-000000000004"
                      value="#[output application/java
---
{
    reachable:      ((vars.verify.status default 'UNKNOWN') != 'UNKNOWN') or (vars.verify.found default false),
    found:          (vars.verify.found default false),
    status:         (vars.verify.status default 'UNKNOWN'),
    runtimeVersion: (vars.verify.runtimeVersion default null)
}]" />
        <logger level="INFO" doc:name="LOG INFO END pf-read-deployment" doc:id="pfpt0005-0005-0005-0005-000000000005" message="#[output application/java --- 'END - pf-read-deployment | reachable=' ++ (vars.deployedState.reachable default false) ++ ' | found=' ++ (vars.deployedState.found default false) ++ ' | runtimeVersion=' ++ (vars.deployedState.runtimeVersion default 'null')]" />

    </sub-flow>

    <!-- ==========================================================================
         pf-read-api-policies  (Batch A #6 — real API-policy detection)
           Requires: vars.apApp   (application name; matched against API Manager assetId)
                     vars.apEnv   (environment name, e.g. "Development")
                     vars.apOrgId (business group / org id)
           Returns:  vars.hasApiPolicies (Boolean) — set from the app's applied policies.

         Resolves envId (cached per org), lists API Manager instances for the org/env,
         matches one to the app by assetId, then reads its applied policies and sets
         vars.hasApiPolicies = (at least one ENABLED policy). When no API instance matches
         the app, the app has no managed API → hasApiPolicies=false.

         Non-fatal: ANY platform/network/schema error leaves vars.hasApiPolicies UNCHANGED
         (the scanFlags placeholder, false) so the assessment is never blocked. API Manager
         response shapes vary by version, so every field is read defensively.
         ========================================================================== -->
    <sub-flow name="pf-read-api-policies"
              doc:id="pfpt0006-0006-0006-0006-000000000001">

        <logger level="INFO" doc:name="LOG INFO START pf-read-api-policies" doc:id="pfpt0006-0006-0006-0006-000000000002" message="#[output application/java --- 'START - pf-read-api-policies | app=' ++ (vars.apApp default '?') ++ ' | env=' ++ (vars.apEnv default '?')]" />
        <try doc:name="TRY api-policy read (non-fatal)"
             doc:id="pfpt0006-0006-0006-0006-000000000003">

            <flow-ref name="pf-get-anypoint-token"
                      doc:name="pf-get-anypoint-token"
                      doc:id="pfpt0006-0006-0006-0006-000000000004" />

            <!-- Resolve environment name → envId (shares the per-org env cache with verify) -->
            <set-variable variableName="vfyOrgId"
                          value="#[vars.apOrgId default '']"
                          doc:name="PV SET vars.vfyOrgId (env cache key)"
                          doc:id="pfpt0006-0006-0006-0006-000000000005" />
            <ee:cache cachingStrategy-ref="anypointEnvCachingStrategy"
                      doc:name="CACHE org environments"
                      doc:id="pfpt0006-0006-0006-0006-000000000006">
                <http:request method="GET"
                              config-ref="Anypoint_Request"
                              path="#['/accounts/api/organizations/' ++ (vars.apOrgId default '') ++ '/environments']"
                              doc:name="GET org environments"
                              doc:id="pfpt0006-0006-0006-0006-000000000007">
                    <http:headers><![CDATA[#[{ "Authorization": "Bearer " ++ (vars.anypointToken default "") }]]]></http:headers>
                </http:request>
            </ee:cache>
            <set-variable variableName="envId"
                          value="#[((payload.data default []) filter ((e) -> upper(e.name default '') == upper(vars.apEnv default '')))[0].id default '']"
                          doc:name="PV SET vars.envId"
                          doc:id="pfpt0006-0006-0006-0006-000000000008" />

            <!-- List API instances for this org/env -->
            <http:request method="GET"
                          config-ref="Anypoint_Request"
                          path="#['/apimanager/api/v1/organizations/' ++ (vars.apOrgId default '') ++ '/environments/' ++ (vars.envId default '') ++ '/apis']"
                          target="apisResp"
                          doc:name="GET API Manager apis"
                          doc:id="pfpt0006-0006-0006-0006-000000000009">
                <http:headers><![CDATA[#[{ "Authorization": "Bearer " ++ (vars.anypointToken default "") }]]]></http:headers>
            </http:request>

            <!-- Match one API instance to the app by assetId (defensive across schemas) -->
            <set-variable variableName="apiInstanceId"
                          doc:name="PV SET vars.apiInstanceId"
                          doc:id="pfpt0006-0006-0006-0006-00000000000a"
                          value="#[%dw 2.0
output application/java
---
do {
    var r       = vars.apisResp default {}
    var grouped = (r.assets default [])
    var flat    = if (!isEmpty(grouped))
                    flatten(grouped map ((a) ->
                        (a.apis default []) map ((api) ->
                            { id: (api.id default null),
                              key: lower((a.assetId default a.exchangeAssetName default '') as String) })))
                  else ((r.instances default []) map ((api) ->
                            { id: (api.id default null),
                              key: lower(((api.assetId default api.exchangeAssetName default '')) as String) }))
    var app     = lower((vars.apApp default '') as String)
    var match   = (flat filter ((x) ->
                     (x.id != null) and (x.key != '') and ((x.key contains app) or (app contains x.key))))[0]
    ---
    if (match == null) null else (match.id as String)
}]" />

            <choice doc:name="CHOICE api instance matched?"
                    doc:id="pfpt0006-0006-0006-0006-00000000000b">
                <when expression="#[vars.apiInstanceId != null]"
                      doc:id="pfpt0006-0006-0006-0006-00000000000c">
                    <http:request method="GET"
                                  config-ref="Anypoint_Request"
                                  path="#['/apimanager/api/v1/organizations/' ++ (vars.apOrgId default '') ++ '/environments/' ++ (vars.envId default '') ++ '/apis/' ++ (vars.apiInstanceId default '') ++ '/policies']"
                                  target="policiesResp"
                                  doc:name="GET applied policies"
                                  doc:id="pfpt0006-0006-0006-0006-00000000000d">
                        <http:headers><![CDATA[#[{ "Authorization": "Bearer " ++ (vars.anypointToken default "") }]]]></http:headers>
                    </http:request>
                    <set-variable variableName="hasApiPolicies"
                                  doc:name="PV SET vars.hasApiPolicies"
                                  doc:id="pfpt0006-0006-0006-0006-00000000000e"
                                  value="#[%dw 2.0
output application/java
---
do {
    var p    = vars.policiesResp default {}
    var pols = (p.policies default (if (p is Array) p else []))
    --- sizeOf((pols default []) filter ((x) -> !(x.disabled default false))) > 0
}]" />
                </when>
                <otherwise doc:id="pfpt0006-0006-0006-0006-00000000000f">
                    <set-variable variableName="hasApiPolicies"
                                  value="#[false]"
                                  doc:name="PV SET vars.hasApiPolicies (no api instance)"
                                  doc:id="pfpt0006-0006-0006-0006-000000000010" />
                    <logger level="INFO" doc:name="LOG INFO no api instance matched" doc:id="pfpt0006-0006-0006-0006-000000000011" message="#[output application/java --- 'no API Manager instance matched app=' ++ (vars.apApp default '?') ++ ' in env=' ++ (vars.apEnv default '?') ++ ' — hasApiPolicies=false']" />
                </otherwise>
            </choice>

            <error-handler>
                <on-error-continue type="ANY"
                                   doc:name="api-policy read failed → leave unchanged"
                                   doc:id="pfpt0006-0006-0006-0006-000000000012">
                    <logger level="WARN"
                            doc:name="LOG WARN api-policy read failed (non-fatal)"
                            doc:id="pfpt0006-0006-0006-0006-000000000013"
                            message="#[output application/java --- 'api-policy read failed (non-fatal), keeping hasApiPolicies unchanged | app=' ++ (vars.apApp default '?') ++ ' | error=' ++ (error.description default 'unknown')]" />
                </on-error-continue>
            </error-handler>

        </try>
        <logger level="INFO" doc:name="LOG INFO END pf-read-api-policies" doc:id="pfpt0006-0006-0006-0006-000000000014" message="#[output application/java --- 'END - pf-read-api-policies | hasApiPolicies=' ++ (vars.hasApiPolicies default false)]" />

    </sub-flow>

</mule>
