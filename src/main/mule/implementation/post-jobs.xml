<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
        REST entry point for POST /jobs.
        Maps the HTTP request body to variables, delegates to the shared
        private sub-flow pf-start-upgrade, then sets HTTP status 202 Accepted.
        The same pf-start-upgrade sub-flow is also called by the MCP start_upgrade tool-listener.
        Note: HTTP status 202 is set here (REST layer only) — pf-start-upgrade is transport-agnostic.
    -->
    <flow name="mf-impl-post-jobs"
          doc:id="f6a7b8c9-0006-0006-0006-000000000001"
          doc:name="mf-impl-post-jobs"
          doc:description="REST entry: maps HTTP body to vars, calls shared pf-start-upgrade, sets 202 Accepted">

        <!-- Snapshot inbound HTTP body FIRST — before any sub-flow call overwrites payload.
             vars.requestBody is read by pf-resolve-coordinates for Tier-2 coordinate overrides. -->
        <ee:transform doc:name="PV SET vars" doc:id="98ce5115-7877-4aa8-ac40-4cfb98e0a71b" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="requestBody" ><![CDATA[payload]]></ee:set-variable>
				<ee:set-variable variableName="appName" ><![CDATA[payload.appName]]></ee:set-variable>
				<ee:set-variable variableName="environment" ><![CDATA[payload.environment]]></ee:set-variable>
				<ee:set-variable variableName="jiraTicketId" ><![CDATA[payload.jiraTicketId]]></ee:set-variable>
				<ee:set-variable variableName="approvedChangePlan" ><![CDATA[payload.approvedChangePlan]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="DEBUG"
                doc:name="LOG DEBUG Request"
                doc:id="f6a7b8c9-0006-0006-0006-000000000002"
                message="#[output application/java --- 'LOG DEBUG | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | app=' ++ (payload.appName default 'unknown')]" />

        <!-- Map HTTP request body fields to variables expected by pf-start-upgrade -->

        <!-- Delegate to the shared sub-flow (also used by MCP start_upgrade tool) -->
        <flow-ref name="pf-start-upgrade"
                  doc:name="pf-start-upgrade"
                  doc:id="f6a7b8c9-0006-0006-0006-000000000007" />

        <!-- Set HTTP 202 Accepted — REST-only concern; MCP callers do not need this -->
        <ee:transform doc:name="DW Set 202 Status"
                      doc:id="f6a7b8c9-0006-0006-0006-000000000008">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus"><![CDATA[202]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

    </flow>

</mule>
