<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
        REST entry point for GET /jobs/{jobId}.
        Extracts the jobId URI path parameter, sets it as a variable, then delegates
        to the shared private sub-flow pf-get-job-status (defined in
        platform-lifecycle-orchestrator-mcp.xml).
        The same pf-get-job-status sub-flow is also called by the MCP get_job_status tool-listener.
        OBJECTSTORE:KEY_NOT_FOUND thrown by the sub-flow is caught by the global error handler → 404.
    -->
    <flow name="mf-impl-get-job-status"
          doc:id="a7b8c9d0-0007-0007-0007-000000000001"
          doc:name="mf-impl-get-job-status"
          doc:description="REST entry: extracts jobId from URI params, calls shared pf-get-job-status sub-flow">

        <!-- Extract jobId from the URI path parameter -->
        <set-variable variableName="jobId"
                      value="#[attributes.uriParams.jobId]"
                      doc:name="PV SET jobId"
                      doc:id="a7b8c9d0-0007-0007-0007-000000000002" />

        <flow-ref name="pf-mdc-stamp" doc:name="pf-mdc-stamp" doc:id="a7b8c9d0-0007-0007-0007-00000000000a" />

        <!-- Delegate to the shared sub-flow (also used by MCP get_job_status tool) -->
        <flow-ref name="pf-get-job-status"
                  doc:name="pf-get-job-status"
                  doc:id="a7b8c9d0-0007-0007-0007-000000000004" />

    </flow>
	
	<!-- pf-get-job-status: retrieves a job record from Object Store         -->
    <!-- Requires: vars.jobId                                                -->
    <!-- Returns:  payload = JobStatus JSON (public fields only)             -->
    <!-- Throws:   OS:KEY_NOT_FOUND → mapped to 404 by error handler         -->
	<sub-flow name="pf-get-job-status" doc:id="b7ab308e-6ec3-4a73-930e-2e92806f6081" doc:description="Shared: retrieve job from Object Store by jobId. Called by REST and MCP." >
		<logger level="INFO" doc:name="LOG INFO START pf-get-job-status" doc:id="62f9de93-8c7f-476b-af3c-e77d5175f3bf" message="#[output application/java --- 'START - pf-get-job-status | status lookup']" />
		<os:retrieve doc:name="OS Retrieve Job Record" doc:id="63895e47-2b8f-4546-9d1c-f3a8aa1e0456" key="#[vars.jobId]" objectStore="jobStore" />
		<ee:transform doc:name="DW Build JobStatus Response" doc:id="52a75152-0301-4176-98bb-9cef66599adc" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
import buildJobStatus from dwl::jobStatus
---
buildJobStatus(payload)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="LOG INFO END pf-get-job-status" doc:id="c052784d-bb53-40f6-a228-a7663b245d6a" message="#[output application/java --- 'END - pf-get-job-status | status found | status=' ++ payload.status]" />
	</sub-flow>

</mule>
