<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <!--
        Implementation flow for POST /webhook.
        Receives GitHub pull_request webhook events.

        Security:   HMAC-SHA256 signature verified before any state change.
        Idempotency: delivery UUID de-duplicated via Object Store.

        Job status transitions triggered here:
          PR_OPEN â†’ DEPLOYING  (on successful merge â€” CI/CD outcome handled by /webhook/cd-result)
    -->
    <flow name="mf-impl-post-webhook" doc:id="b8c9d0e1-0008-0008-0008-000000000001">

        <!-- â”€â”€ HMAC signature validation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
             Compute expected = "sha256=" ++ HMAC-SHA256(webhookSecret, rawBody).
             vars.rawBody and vars.ghSignature were captured in the main flow BEFORE APIkit
             parsed the payload, so rawBody is the exact bytes GitHub signed.
             â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <ee:transform doc:name="DW Compute Expected HMAC Signature"
                      doc:id="b8c9d0e1-0008-0008-0008-000000000020"
                      doc:description="Compute sha256=HEX(HMAC-SHA256(webhookSecret, rawBody)) for comparison with x-hub-signature-256">
            <ee:variables>
                <ee:set-variable variableName="expectedSig"><![CDATA[%dw 2.0
import dw::Crypto
output text/plain
---
"sha256=" ++ Crypto::HMACWith(p('secure::github.webhookSecret') as Binary, vars.rawBody, "HmacSHA256")]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <choice doc:name="CHOICE signature valid?"
                doc:id="b8c9d0e1-0008-0008-0008-000000000022"
                doc:description="Reject any delivery whose x-hub-signature-256 header does not match the computed HMAC">
            <when expression="#[vars.ghSignature == '' or vars.ghSignature != vars.expectedSig]"
                  doc:name="signature missing or invalid"
                  doc:id="b8c9d0e1-0008-0008-0008-000000000023">

                <logger level="WARN"
                        doc:name="LOG WARN Invalid Webhook Signature"
                        doc:id="b8c9d0e1-0008-0008-0008-000000000024"
                        message="#[output application/java --- 'LOG WARN | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | INVALID webhook signature | delivery=' ++ vars.ghDelivery ++ ' | event=' ++ vars.ghEvent]" />

                <set-variable variableName="httpStatus"
                              value="401"
                              doc:name="PV SET httpStatus 401"
                              doc:id="b8c9d0e1-0008-0008-0008-000000000025" />

                <ee:transform doc:name="DW Set 401 Error Body"
                              doc:id="b8c9d0e1-0008-0008-0008-000000000026">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ error: "invalid signature", correlationId: correlationId }]]></ee:set-payload>
                    </ee:message>
                </ee:transform>

            </when>
            <otherwise doc:name="signature valid â€” proceed"
                       doc:id="b8c9d0e1-0008-0008-0008-000000000027">

                <!-- â”€â”€ Idempotency: de-duplicate by GitHub delivery UUID â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
                     NOTE: os:retrieve treats a NULL os:default-value as "no default" and throws
                     OS:KEY_NOT_FOUND on a missing key. A brand-new delivery (the common case) has
                     no key, so we default to `false` (not seen) â€” this also preserves the payload,
                     which a null default + error handler would not. -->
                <os:retrieve key="#['delivery::' ++ vars.ghDelivery]"
                             objectStore="idempotencyStore"
                             target="seenDelivery"
                             doc:name="OS Retrieve delivery idempotency key"
                             doc:id="b8c9d0e1-0008-0008-0008-000000000028">
                    <os:default-value>#[false]</os:default-value>
                </os:retrieve>

                <choice doc:name="CHOICE duplicate delivery?"
                        doc:id="b8c9d0e1-0008-0008-0008-000000000029"
                        doc:description="Skip processing if this delivery UUID was already handled">
                    <when expression="#[vars.seenDelivery == true]"
                          doc:name="duplicate delivery â€” skip"
                          doc:id="b8c9d0e1-0008-0008-0008-000000000030">

                        <logger level="INFO"
                                doc:name="LOG INFO Duplicate Delivery Skipped"
                                doc:id="b8c9d0e1-0008-0008-0008-000000000031"
                                message="#[output application/java --- 'LOG INFO | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | duplicate delivery, skipping | delivery=' ++ vars.ghDelivery]" />

                        <ee:transform doc:name="DW Set 200 Duplicate Acknowledgement"
                                      doc:id="b8c9d0e1-0008-0008-0008-000000000032">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ acknowledged: true, duplicate: true, correlationId: correlationId }]]></ee:set-payload>
                            </ee:message>
                        </ee:transform>

                    </when>
                    <otherwise doc:name="new delivery â€” process"
                               doc:id="b8c9d0e1-0008-0008-0008-000000000033">

                        <!-- Mark this delivery as processed before touching any job state -->
                        <os:store key="#['delivery::' ++ vars.ghDelivery]"
                                  objectStore="idempotencyStore"
                                  doc:name="OS Store delivery idempotency key"
                                  doc:id="b8c9d0e1-0008-0008-0008-000000000034">
                            <os:value>#[true]</os:value>
                        </os:store>

                        <logger level="DEBUG"
                                doc:name="LOG DEBUG Webhook Received"
                                doc:id="b8c9d0e1-0008-0008-0008-000000000002"
                                message="#[output application/java --- 'LOG DEBUG | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | webhook event=' ++ vars.ghEvent ++ ' | action=' ++ (payload.action default 'unknown') ++ ' | delivery=' ++ vars.ghDelivery]" />

                        <!--
                            Only process pull_request events where the PR was merged.
                            All other events are acknowledged without state changes.
                        -->
                        <choice doc:name="Is PR Merge Event?"
                                doc:id="b8c9d0e1-0008-0008-0008-000000000003">

                            <when expression="#[payload.action == 'closed' and payload.pull_request.merged == true]"
                                  doc:name="PR merged">

                                <set-variable variableName="mergedBranch"
                                              value="#[(payload.pull_request.head.ref default '') as String]"
                                              doc:name="PV SET mergedBranch"
                                              doc:id="b8c9d0e1-0008-0008-0008-000000000004" />

                                <set-variable variableName="prUrl"
                                              value="#[(payload.pull_request.html_url default '') as String]"
                                              doc:name="PV SET prUrl"
                                              doc:id="b8c9d0e1-0008-0008-0008-000000000005" />

                                <logger level="INFO"
                                        doc:name="LOG INFO PR Merged"
                                        doc:id="b8c9d0e1-0008-0008-0008-000000000006"
                                        message="#[output application/java --- 'LOG INFO | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | PR merged | branch=' ++ vars.mergedBranch ++ ' | prUrl=' ++ vars.prUrl]" />

                                <!-- get-or-empty: an untracked merged branch has no key. A null
                                     os:default-value would throw OS:KEY_NOT_FOUND, so default to ""
                                     (no mapping) â€” this also preserves the payload. -->
                                <os:retrieve key="#['branch::' ++ vars.mergedBranch]"
                                             objectStore="indexStore"
                                             target="jobIdFromBranch"
                                             doc:name="OS Retrieve jobId by Branch"
                                             doc:id="b8c9d0e1-0008-0008-0008-000000000007">
                                    <os:default-value>#[""]</os:default-value>
                                </os:retrieve>

                                <choice doc:name="Is Branch Mapped to a Job?"
                                        doc:id="b8c9d0e1-0008-0008-0008-000000000008">

                                    <when expression="#[vars.jobIdFromBranch != null and vars.jobIdFromBranch != '']"
                                          doc:name="branch mapped to job">

                                        <os:retrieve key="#[vars.jobIdFromBranch]"
                                                     objectStore="jobStore"
                                                     doc:name="OS Retrieve Job Record"
                                                     doc:id="b8c9d0e1-0008-0008-0008-000000000009" />

                                        <!--
                                            Transition to DEPLOYING â€” the final DEPLOYED/FAILED_DEPLOY
                                            transition is set by the CD pipeline via /webhook/cd-result.
                                            completedAt is NOT set here; it belongs to the terminal state.
                                        -->
                                        <ee:transform doc:name="DW Update Job Status to DEPLOYING"
                                                      doc:id="b8c9d0e1-0008-0008-0008-000000000010">
                                            <ee:message>
                                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
import mergeWith from dw::core::Objects
---
payload mergeWith {
    status:     "DEPLOYING",
    prUrl:      vars.prUrl,
    branchName: vars.mergedBranch,
    updatedAt:  (now() >> |+00:00|) as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
}]]></ee:set-payload>
                                            </ee:message>
                                        </ee:transform>

                                        <os:store key="#[vars.jobIdFromBranch]"
                                                  objectStore="jobStore"
                                                  doc:name="OS Update Job to DEPLOYING"
                                                  doc:id="b8c9d0e1-0008-0008-0008-000000000011">
                                            <os:value>#[payload]</os:value>
                                        </os:store>

                                        <logger level="INFO"
                                                doc:name="LOG INFO Job DEPLOYING"
                                                doc:id="b8c9d0e1-0008-0008-0008-000000000012"
                                                message="#[output application/java --- 'LOG INFO | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | jobId=' ++ vars.jobIdFromBranch ++ ' | status=DEPLOYING | awaiting CD pipeline callback']" />

                                    </when>

                                    <otherwise>
                                        <logger level="DEBUG"
                                                doc:name="LOG DEBUG Branch Not Tracked"
                                                doc:id="b8c9d0e1-0008-0008-0008-000000000013"
                                                message="#[output application/java --- 'LOG DEBUG | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | branch not tracked, ignoring | branch=' ++ vars.mergedBranch]" />
                                    </otherwise>

                                </choice>

                            </when>

                            <otherwise>
                                <logger level="DEBUG"
                                        doc:name="LOG DEBUG Non-Merge Event Ignored"
                                        doc:id="b8c9d0e1-0008-0008-0008-000000000014"
                                        message="#[output application/java --- 'LOG DEBUG | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | webhook event ignored | event=' ++ vars.ghEvent ++ ' | action=' ++ (payload.action default 'unknown')]" />
                            </otherwise>

                        </choice>

                        <!-- Return 200 to GitHub for all valid, non-duplicate events -->
                        <ee:transform doc:name="DW Set 200 Acknowledgement"
                                      doc:id="b8c9d0e1-0008-0008-0008-000000000015">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ acknowledged: true, correlationId: correlationId }]]></ee:set-payload>
                            </ee:message>
                        </ee:transform>

                    </otherwise>
                </choice>

            </otherwise>
        </choice>

    </flow>

    <!--
        mf-impl-post-cd-result â€” POST /webhook/cd-result
        Called by the GitHub Actions CD pipeline after deployment.
        Body: { jobId: String, result: "success"|"failure", deployUrl?: String }
        Auth: HMAC-SHA256 over the raw body in header X-CD-Signature-256 ("sha256=" ++ hex),
              same scheme as POST /webhook. Transitional fallback: X-CD-Token == secure::github.webhookSecret
              (kept so existing local tests / un-migrated CD pipelines keep working; remove once the CD
              job signs — see DESIGN_DECISIONS #1).
        Finalizes the job: DEPLOYED (success) or FAILED_DEPLOY (failure).
    -->
    <flow name="mf-impl-post-cd-result"
          doc:id="b8c9d0e1-0008-0008-0008-000000000016"
          doc:name="mf-impl-post-cd-result"
          doc:description="Receive CD pipeline result callback; authenticate, finalize job status, release lock.">

        <!-- â”€â”€ Step 1: Shared-token authentication â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <!-- Compute expected HMAC over the raw body (identical scheme to POST /webhook).
             vars.rawBody is captured in the main flow for every route. -->
        <ee:transform doc:name="DW Compute Expected CD HMAC Signature"
                      doc:id="b9c0d1e2-0009-0009-0009-0000000000a1"
                      doc:description="Compute sha256=HEX(HMAC-SHA256(webhookSecret, rawBody)) for comparison with X-CD-Signature-256">
            <ee:variables>
                <ee:set-variable variableName="expectedCdSig"><![CDATA[%dw 2.0
import dw::Crypto
output text/plain
---
"sha256=" ++ Crypto::HMACWith(p('secure::github.webhookSecret') as Binary, vars.rawBody, "HmacSHA256")]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <set-variable variableName="cdSignature"
                      value="#[attributes.headers['x-cd-signature-256'] default '']"
                      doc:name="PV SET cdSignature"
                      doc:id="b9c0d1e2-0009-0009-0009-0000000000a2" />
        <set-variable variableName="cdToken"
                      value="#[attributes.headers['x-cd-token'] default '']"
                      doc:name="PV SET cdToken"
                      doc:id="b9c0d1e2-0009-0009-0009-0000000000a3" />

        <choice doc:name="CHOICE cd-result auth valid?"
                doc:id="b9c0d1e2-0009-0009-0009-000000000001"
                doc:description="Reject unless a valid HMAC signature (X-CD-Signature-256) OR the transitional shared token (X-CD-Token) is presented">
            <when expression="#[not ( (vars.cdSignature != '' and vars.cdSignature == vars.expectedCdSig) or (vars.cdToken != '' and vars.cdToken == p('secure::github.webhookSecret')) )]"
                  doc:name="auth missing or invalid"
                  doc:id="b9c0d1e2-0009-0009-0009-000000000002">

                <logger level="WARN"
                        doc:name="LOG WARN Invalid CD Auth"
                        doc:id="b9c0d1e2-0009-0009-0009-000000000003"
                        message="#[output application/java --- 'LOG WARN | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | invalid X-CD-Token â€” rejecting']" />

                <set-variable variableName="httpStatus"
                              value="401"
                              doc:name="PV SET httpStatus 401"
                              doc:id="b9c0d1e2-0009-0009-0009-000000000004" />

                <ee:transform doc:name="DW Set 401 Error Body"
                              doc:id="b9c0d1e2-0009-0009-0009-000000000005">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ error: "invalid cd token", correlationId: correlationId }]]></ee:set-payload>
                    </ee:message>
                </ee:transform>

            </when>
            <otherwise doc:name="token valid â€” proceed"
                       doc:id="b9c0d1e2-0009-0009-0009-000000000006">

                <!-- â”€â”€ Step 2: Parse CD callback body â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->

                <!-- â”€â”€ Step 3: Load job record (throws OS:KEY_NOT_FOUND â†’ 404 if missing) â”€â”€ -->
                <ee:transform doc:name="PV SET payload vars" doc:id="63c02425-9a3f-4309-ad9b-850f577a592d">
					<ee:message>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="jobId" ><![CDATA[payload.jobId]]></ee:set-variable>
						<ee:set-variable variableName="cdResult" ><![CDATA[payload.result default '']]></ee:set-variable>
						<ee:set-variable variableName="deployUrl" ><![CDATA[payload.deployUrl default null]]></ee:set-variable>
						<ee:set-variable variableName="cdError" ><![CDATA[payload.error default null]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<os:retrieve key="#[vars.jobId]"
                             objectStore="jobStore"
                             doc:name="OS Retrieve Job Record"
                             doc:id="b9c0d1e2-0009-0009-0009-000000000011" />

                <!-- â”€â”€ Step 4: Capture record fields before any transform overwrites payload â”€
                     jobRec holds the full record; downstream sub-flows (verify/rollback) run
                     HTTP calls that clobber `payload`, so finalize transforms build from jobRec. -->
				<ee:transform doc:name="PVT SET record vars" doc:id="665264f0-76f0-4ddb-8e2d-4b2478119611">
											<ee:message>
											</ee:message>
					<ee:variables>
						<ee:set-variable variableName="jobRec"><![CDATA[payload]]></ee:set-variable>
						<ee:set-variable variableName="appName"><![CDATA[payload.appName]]></ee:set-variable>
						<ee:set-variable variableName="coords"><![CDATA[payload.coords]]></ee:set-variable>
						<ee:set-variable variableName="branchName"><![CDATA[payload.branchName]]></ee:set-variable>
						<ee:set-variable variableName="commitSha"><![CDATA[payload.commitSha]]></ee:set-variable>
						<ee:set-variable variableName="prNumber"><![CDATA[payload.prNumber]]></ee:set-variable>
						<ee:set-variable variableName="curStatus"><![CDATA[payload.status default '']]></ee:set-variable>
						<ee:set-variable variableName="environment" ><![CDATA[payload.environment default '']]></ee:set-variable>
						<ee:set-variable variableName="jiraTicketId" ><![CDATA[payload.jiraTicketId default null]]></ee:set-variable>
						<ee:set-variable variableName="prUrl" ><![CDATA[payload.prUrl default null]]></ee:set-variable>
					</ee:variables>
										</ee:transform>

                <!-- â”€â”€ Step 5: Idempotency / terminal guard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
                     If the job is already in a terminal state, return 200 and skip re-processing.
                     â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
				<choice doc:name="CHOICE already terminal?"
                        doc:id="b9c0d1e2-0009-0009-0009-000000000018"
                        doc:description="Skip if the job was already finalized by a previous cd-result callback">
                    <when expression="#[vars.curStatus == 'DEPLOYED' or vars.curStatus == 'FAILED_DEPLOY']"
                          doc:name="job already terminal"
                          doc:id="b9c0d1e2-0009-0009-0009-000000000019">

                        <logger level="INFO"
                                doc:name="LOG INFO CD Result Already Final"
                                doc:id="b9c0d1e2-0009-0009-0009-000000000020"
                                message="#[output application/java --- 'LOG INFO | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | cd-result already final, skipping | jobId=' ++ vars.jobId ++ ' | status=' ++ vars.curStatus]" />

                        <ee:transform doc:name="DW Set 200 Idempotent Acknowledgement"
                                      doc:id="b9c0d1e2-0009-0009-0009-000000000021">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ acknowledged: true, idempotent: true, jobId: vars.jobId, status: vars.curStatus }]]></ee:set-payload>
                            </ee:message>
                        </ee:transform>

                    </when>
                    <otherwise doc:name="job not yet terminal â€” proceed"
                               doc:id="b9c0d1e2-0009-0009-0009-000000000022">

                        <!-- â”€â”€ Step 6: Outcome branch â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                        <choice doc:name="CHOICE cdResult success|failure|unknown?"
                                doc:id="b9c0d1e2-0009-0009-0009-000000000023"
                                doc:description="Finalize job as DEPLOYED (success) or FAILED_DEPLOY (failure)">

                            <!-- â”€â”€ 6a: SUCCESS (CI-reported) â€” confirm on platform before finalizing â”€ -->
                            <when expression="#[vars.cdResult == 'success']"
                                  doc:name="success"
                                  doc:id="b9c0d1e2-0009-0009-0009-000000000024">

                                <!-- â”€â”€ 6a-i: Post-deploy platform confirmation (ADR-015) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
                                     CI said success. Make ONE Application Manager call to confirm the
                                     app is actually healthy on CH2.0:
                                       - platform verified + healthy  â†’ DEPLOYED
                                       - platform verified + unhealthy â†’ FAILED_DEPLOY (discrepancy)
                                       - platform unreachable/disabled â†’ trust CI signal â†’ DEPLOYED
                                     â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                                <choice doc:name="CHOICE verify enabled?"
                                        doc:id="b9c0d1e2-0009-0009-0009-00000000006a">
                                    <when expression="#[(p('anypoint.verify.enabled') default 'true') == 'true']"
                                          doc:name="verify enabled"
                                          doc:id="b9c0d1e2-0009-0009-0009-00000000006b">
                                        <ee:transform doc:name="PV SET vars" doc:id="74c02f41-5bd4-4f0e-9d40-5657c83652d0">
											<ee:message>
											</ee:message>
											<ee:variables>
												<ee:set-variable variableName="vfyEnv"><![CDATA[output application/java --- (vars.environment default '') as String]]></ee:set-variable>
												<ee:set-variable variableName="vfyOrgId"><![CDATA[output application/java --- (vars.coords.orgId default p('anypoint.defaultOrgId')) as String]]></ee:set-variable>
												<ee:set-variable variableName="vfyApp"><![CDATA[output application/java --- (vars.appName default '') as String]]></ee:set-variable>
											</ee:variables>
										</ee:transform>
                                        <flow-ref name="pf-verify-deployment"
                                                  doc:name="pf-verify-deployment"
                                                  doc:id="b9c0d1e2-0009-0009-0009-00000000006f" />
                                    </when>
                                    <otherwise doc:name="verify disabled"
                                               doc:id="b9c0d1e2-0009-0009-0009-000000000070">
                                        <ee:transform doc:name="DW SET vars.verify (disabled)"
                                                      doc:id="b9c0d1e2-0009-0009-0009-000000000071">
                                            <ee:variables>
                                                <ee:set-variable variableName="verify"><![CDATA[%dw 2.0
output application/java
---
{ verified: false, found: false, status: 'DISABLED', healthy: false, runtimeVersion: null }]]></ee:set-variable>
                                            </ee:variables>
                                        </ee:transform>
                                    </otherwise>
                                </choice>

                                <set-variable variableName="deployVerdict"
                                              value="#[if ((vars.verify.verified default false) and not (vars.verify.healthy default false)) 'FAILED_DEPLOY' else 'DEPLOYED']"
                                              doc:name="PV SET vars.deployVerdict"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000072" />

                                <ee:transform doc:name="DW Update Job Status (verified)"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000025">
                                    <ee:message>
                                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
import mergeWith from dw::core::Objects
---
vars.jobRec mergeWith {
    status:                 vars.deployVerdict,
    deployUrl:              vars.deployUrl,
    platformVerified:       (vars.verify.verified default false),
    platformStatus:         (vars.verify.status default null),
    platformRuntimeVersion: (vars.verify.runtimeVersion default null),
    completedAt:            (now() >> |+00:00|) as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"},
    updatedAt:              (now() >> |+00:00|) as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
}
mergeWith (if (vars.deployVerdict == "FAILED_DEPLOY")
      { error: "CD reported success but platform status=" ++ (vars.verify.status default "UNKNOWN") }
    else {})]]></ee:set-payload>
                                    </ee:message>
                                </ee:transform>
								<os:store key="#[vars.jobId]"
                                          objectStore="jobStore"
                                          doc:name="OS Store finalized Job Record"
                                          doc:id="b9c0d1e2-0009-0009-0009-000000000026">
                                    <os:value>#[payload]</os:value>
                                </os:store>

                                <!-- Release single-flight lock â€” idempotent + non-fatal -->
                                <set-variable variableName="lockApp" value="#[vars.appName default '']"
                                              doc:name="PV lockApp" doc:id="b9c0d1e2-0009-0009-0009-000000000027" />
                                <flow-ref name="pf-release-lock" doc:name="pf-release-lock (finalized)"
                                          doc:id="b9c0d1e2-0009-0009-0009-000000000028" />

                                <!-- â”€â”€ 6a-ii: Notify by verdict â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                                <choice doc:name="CHOICE notify by verdict?"
                                        doc:id="b9c0d1e2-0009-0009-0009-000000000073">
                                    <when expression="#[vars.deployVerdict == 'DEPLOYED']"
                                          doc:name="DEPLOYED â€” Slack success"
                                          doc:id="b9c0d1e2-0009-0009-0009-000000000074">
                                        <!-- Slack success notification â€” non-fatal -->
                                        <try doc:name="TRY Slack DEPLOYED notification (non-fatal)"
                                             doc:id="b9c0d1e2-0009-0009-0009-000000000031">
                                            <ee:transform doc:name="DW Build Slack DEPLOYED message"
                                                          doc:id="b9c0d1e2-0009-0009-0009-000000000032">
                                                <ee:message>
                                                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    channel: p('slack.channel'),
    text: (":white_check_mark: *Java 17 upgrade DEPLOYED* â€” " ++ vars.appName
           ++ "\nJob " ++ vars.jobId
           ++ (if ((vars.verify.verified default false)) ("\nPlatform status: " ++ (vars.verify.status default "UNKNOWN")) else "\nPlatform: unverified (trusting CI)")
           ++ (if (vars.jiraTicketId != null) ("\nJira: <" ++ (p('jira.baseUrl') default '') ++ "/browse/" ++ (vars.jiraTicketId as String) ++ "|" ++ (vars.jiraTicketId as String) ++ ">") else "")
           ++ (if (vars.deployUrl != null) ("\n" ++ vars.deployUrl) else ""))
}]]></ee:set-payload>
                                                </ee:message>
                                            </ee:transform>
                                            <set-variable variableName="slackPath"
                                                          value="#[p('secure::slack.webhookUrl') replace 'https://hooks.slack.com' with '']"
                                                          doc:name="PV SET slackPath"
                                                          doc:id="b9c0d1e2-0009-0009-0009-000000000033" />
                                            <http:request method="POST"
                                                          config-ref="Slack_Request"
                                                          path="#[vars.slackPath]"
                                                          doc:name="POST Slack DEPLOYED notification"
                                                          doc:id="b9c0d1e2-0009-0009-0009-000000000034" />
                                            <error-handler>
                                                <on-error-continue type="ANY"
                                                                   doc:id="b9c0d1e2-0009-0009-0009-000000000035">
                                                    <logger level="WARN"
                                                            doc:name="LOG WARN Slack DEPLOYED notification failed"
                                                            doc:id="b9c0d1e2-0009-0009-0009-000000000036"
                                                            message="#[output application/java --- 'LOG WARN | flow=' ++ flow.name ++ ' | Slack DEPLOYED notification error swallowed: ' ++ (error.description default 'unknown')]" />
                                                </on-error-continue>
                                            </error-handler>
                                        </try>
                                    </when>
                                    <otherwise doc:name="FAILED_DEPLOY â€” discrepancy notify"
                                               doc:id="b9c0d1e2-0009-0009-0009-000000000075">
                                        <flow-ref name="pf-notify-failure"
                                                  doc:name="pf-notify-failure (platform discrepancy)"
                                                  doc:id="b9c0d1e2-0009-0009-0009-000000000076" />
                                    </otherwise>
                                </choice>

                                <!-- â”€â”€ 6a-iii: Jira comment on the final decision (with PR link) â”€â”€â”€â”€ -->
<set-variable variableName="jiraCommentText"
              value="#[output text/plain
---
if (vars.deployVerdict == 'DEPLOYED')
    ('Java 17 upgrade DEPLOYED for ' ++ (vars.appName as String) ++ ' (job ' ++ (vars.jobId as String) ++ '). Platform status: ' ++ ((vars.verify.status default 'n/a') as String) ++ '.')
else
    ('Java 17 upgrade marked FAILED_DEPLOY for ' ++ (vars.appName as String) ++ ' (job ' ++ (vars.jobId as String) ++ '). CI reported success but platform status=' ++ ((vars.verify.status default 'UNKNOWN') as String) ++ '.')]"
                                              doc:name="PV SET vars.jiraCommentText (finalize)"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000037a" />
                                <set-variable variableName="jiraCommentUrl"
                                              value="#[vars.prUrl default vars.deployUrl default null]"
                                              doc:name="PV SET vars.jiraCommentUrl (finalize)"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000037b" />
                                <flow-ref name="pf-jira-comment"
                                          doc:name="pf-jira-comment (final decision)"
                                          doc:id="b9c0d1e2-0009-0009-0009-000000000037c" />

                                <logger level="INFO"
                                        doc:name="LOG INFO Job finalized"
                                        doc:id="b9c0d1e2-0009-0009-0009-000000000037"
                                        message="#[output application/java --- 'LOG INFO | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | jobId=' ++ vars.jobId ++ ' | status=' ++ vars.deployVerdict ++ ' | platformVerified=' ++ (vars.verify.verified default false) ++ ' | platformStatus=' ++ (vars.verify.status default 'n/a') ++ ' | deployUrl=' ++ (vars.deployUrl default 'n/a')]" />

                                <ee:transform doc:name="DW Set 200 finalized Acknowledgement"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000038">
                                    <ee:message>
                                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ acknowledged: true, jobId: vars.jobId, status: vars.deployVerdict, platformVerified: (vars.verify.verified default false) }]]></ee:set-payload>
                                    </ee:message>
                                </ee:transform>

                            </when>

                            <!-- â”€â”€ 6b: FAILURE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                            <when expression="#[vars.cdResult == 'failure']"
                                  doc:name="failure"
                                  doc:id="b9c0d1e2-0009-0009-0009-000000000039">

                                <flow-ref name="pf-rollback"
                                          doc:name="pf-rollback (best-effort)"
                                          doc:id="b9c0d1e2-0009-0009-0009-000000000040" />

                                <ee:transform doc:name="DW Update Job Status to FAILED_DEPLOY"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000041">
                                    <ee:message>
                                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
import mergeWith from dw::core::Objects
---
vars.jobRec mergeWith {
    status:      "FAILED_DEPLOY",
    error:       (vars.cdError default "CD pipeline reported failure"),
    rolledBack:  true,
    completedAt: (now() >> |+00:00|) as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"},
    updatedAt:   (now() >> |+00:00|) as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
}]]></ee:set-payload>
                                    </ee:message>
                                </ee:transform>

                                <os:store key="#[vars.jobId]"
                                          objectStore="jobStore"
                                          doc:name="OS Store FAILED_DEPLOY Job Record"
                                          doc:id="b9c0d1e2-0009-0009-0009-000000000042">
                                    <os:value>#[payload]</os:value>
                                </os:store>

                                <!-- Release single-flight lock â€” idempotent + non-fatal -->
                                <set-variable variableName="lockApp" value="#[vars.appName default '']"
                                              doc:name="PV lockApp" doc:id="b9c0d1e2-0009-0009-0009-000000000043" />
                                <flow-ref name="pf-release-lock" doc:name="pf-release-lock (failed deploy)"
                                          doc:id="b9c0d1e2-0009-0009-0009-000000000044" />

                                <flow-ref name="pf-notify-failure"
                                          doc:name="pf-notify-failure (FAILED_DEPLOY)"
                                          doc:id="b9c0d1e2-0009-0009-0009-000000000047" />

                                <!-- Jira comment on the final decision (link to the ROLLBACK PR when one was opened) -->
                                <set-variable variableName="jiraCommentText"
                                              value="#[output text/plain --- ('Java 17 upgrade FAILED_DEPLOY for ' ++ (vars.appName as String) ++ ' (job ' ++ (vars.jobId as String) ++ '). ' ++ ((vars.cdError default 'CD pipeline reported failure') as String) ++ (if ((vars.revertPrUrl default '') != '') ' A rollback (revert) PR has been opened to restore the pre-upgrade state.' else ' Rollback attempted.'))]"
                                              doc:name="PV SET vars.jiraCommentText (failure)"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000047a" />
                                <set-variable variableName="jiraCommentUrl"
                                              value="#[vars.revertPrUrl default vars.prUrl default null]"
                                              doc:name="PV SET vars.jiraCommentUrl (failure)"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000047b" />
                                <flow-ref name="pf-jira-comment"
                                          doc:name="pf-jira-comment (failure)"
                                          doc:id="b9c0d1e2-0009-0009-0009-000000000047c" />

                                <logger level="WARN"
                                        doc:name="LOG WARN Job FAILED_DEPLOY"
                                        doc:id="b9c0d1e2-0009-0009-0009-000000000048"
                                        message="#[output application/java --- 'LOG WARN | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | jobId=' ++ vars.jobId ++ ' | status=FAILED_DEPLOY']" />

                                <ee:transform doc:name="DW Set 200 FAILED_DEPLOY Acknowledgement"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000049">
                                    <ee:message>
                                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ acknowledged: true, jobId: vars.jobId, status: "FAILED_DEPLOY" }]]></ee:set-payload>
                                    </ee:message>
                                </ee:transform>

                            </when>

                            <!-- â”€â”€ 6c: UNKNOWN result â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
                            <otherwise doc:name="unknown result â€” reject"
                                       doc:id="b9c0d1e2-0009-0009-0009-000000000050">

                                <logger level="WARN"
                                        doc:name="LOG WARN Unknown CD Result"
                                        doc:id="b9c0d1e2-0009-0009-0009-000000000051"
                                        message="#[output application/java --- 'LOG WARN | flow=' ++ flow.name ++ ' | correlationId=' ++ correlationId ++ ' | unknown cdResult=' ++ vars.cdResult]" />

                                <set-variable variableName="httpStatus"
                                              value="400"
                                              doc:name="PV SET httpStatus 400"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000052" />

                                <ee:transform doc:name="DW Set 400 Unknown Result Body"
                                              doc:id="b9c0d1e2-0009-0009-0009-000000000053">
                                    <ee:message>
                                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ error: "invalid result (expected success|failure)", correlationId: correlationId }]]></ee:set-payload>
                                    </ee:message>
                                </ee:transform>

                            </otherwise>

                        </choice>

                    </otherwise>
                </choice>

            </otherwise>
        </choice>

    </flow>

</mule>
